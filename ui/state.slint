    public function navigate-to(tab: int) {
        if AppState.presentation-mode && tab != 0 { return; }
        if (tab == 0 || tab == 2 || tab == 4) && AppState.current-tab != tab {
            AppState.iris-fullscreen = false;
            AppState.viewport-controls-interacting = false;
            AppState.focused-text-fields = 0;
            AppState.image-controls-open = false;
            AppState.library-map-open = false;
            AppState.current-tab = tab;
            AppState.preview-tab-changed(tab == 0);
        }
    }

    public function link-view(reference: bool) {
        if !AppState.comparison-enabled || !AppState.comparison-linked { return; }
        let ratio = max(0.01,AppState.comparison-zoom-ratio);
        if reference {
            AppState.viewer-fit = AppState.comparison-fit;
            AppState.viewer-zoom = clamp(round(AppState.comparison-zoom/ratio),10,800);
            AppState.comparison-zoom = clamp(round(AppState.viewer-zoom*ratio),10,800);
            AppState.viewer-pan-x = (AppState.comparison-pan-x - AppState.comparison-offset-x*AppState.comparison-zoom/100)/ratio;
            AppState.viewer-pan-y = (AppState.comparison-pan-y - AppState.comparison-offset-y*AppState.comparison-zoom/100)/ratio;
        } else {
            AppState.comparison-fit = AppState.viewer-fit;
            AppState.comparison-zoom = clamp(round(AppState.viewer-zoom*ratio),10,800);
            AppState.viewer-zoom = clamp(round(AppState.comparison-zoom/ratio),10,800);
            AppState.comparison-pan-x = AppState.viewer-pan-x*ratio + AppState.comparison-offset-x*AppState.comparison-zoom/100;
            AppState.comparison-pan-y = AppState.viewer-pan-y*ratio + AppState.comparison-offset-y*AppState.comparison-zoom/100;
        }
    }

    public function fit-viewer() {
        AppState.viewer-fit = true; AppState.viewer-pan-x = 0px; AppState.viewer-pan-y = 0px;
        if AppState.comparison-linked {
            AppState.comparison-zoom-ratio = 1; AppState.comparison-offset-x = 0px; AppState.comparison-offset-y = 0px;
            AppState.comparison-fit = true; AppState.comparison-pan-x = 0px; AppState.comparison-pan-y = 0px;
        }
    }

    public function toggle-comparison-link() {
        if AppState.comparison-linked { AppState.comparison-linked = false; }
        else {
            let current = max(1, AppState.viewer-effective-zoom);
            let reference = max(1, AppState.comparison-effective-zoom);
            AppState.comparison-zoom-ratio = reference/current;
            AppState.comparison-offset-x = (AppState.comparison-pan-x - AppState.viewer-pan-x * AppState.comparison-zoom-ratio)/(reference/100);
            AppState.comparison-offset-y = (AppState.comparison-pan-y - AppState.viewer-pan-y * AppState.comparison-zoom-ratio)/(reference/100);
            if !AppState.viewer-fit || !AppState.comparison-fit {
                AppState.viewer-fit = false; AppState.comparison-fit = false;
                AppState.viewer-zoom = round(current); AppState.comparison-zoom = round(reference);
            }
            AppState.comparison-linked = true;
        }
    }

    public function dismiss-viewer() {
        if AppState.viewer-open {
            if !AppState.viewer-review-dirty && !AppState.viewer-review-busy {
                AppState.viewer-open = false; AppState.viewer-loading = false; AppState.viewer-fullscreen = false;
            }
            AppState.close-viewer();
        }
    }

    public function dismiss-top-overlay() {
        if AppState.calendar-open { AppState.calendar-open = false; }
        else if AppState.consultation-open && !AppState.viewer-open && !AppState.presentation-mode { AppState.close-consultation(); }
        else if AppState.patient-edit-open {
            if !AppState.patient-action-pending { AppState.patient-edit-open = false; AppState.focused-text-fields = 0; AppState.focus-main-controls(); }
        }
        else if AppState.viewer-open && !AppState.viewer-is-video && AppState.image-only { AppState.toggle-image-only(); }
        else if AppState.viewer-open && AppState.viewer-fullscreen { AppState.viewer-fullscreen = false; }
        else if AppState.viewer-open { AppState.dismiss-viewer(); }
        else if AppState.library-map-open { AppState.library-map-open = false; }
        else if AppState.image-controls-open { AppState.image-controls-open = false; }
        else if AppState.presentation-mode { AppState.toggle-presentation(); }
        else if AppState.iris-fullscreen { AppState.iris-fullscreen = false; }
    }

    public function show-viewport-controls() {
        AppState.viewport-controls-visible = true;
        AppState.viewport-controls-revision += 1;
    }
}
