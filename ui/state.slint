    public function select-photo-panel(panel: int) {
        if panel > 0 && AppState.image-only { AppState.image-only = false; AppState.show-photo-controls(); }
        AppState.viewer-panel = panel;
        AppState.preferred-photo-panel = panel;
        AppState.viewer-tool = 0;
        AppState.interface-edited();
    }
    public function show-photo-controls() {
        AppState.photo-controls-visible = true;
        AppState.photo-controls-revision += 1;
    }
    public function toggle-image-only() {
        AppState.image-only = !AppState.image-only;
        AppState.viewer-tool = 0;
        AppState.viewer-loupe = false;
        AppState.show-photo-controls();
        AppState.interface-edited();
    }

