    in-out property <bool> text-field-focused: AppState.focused-text-fields > 0;
    in-out property <bool> recording-busy: AppState.is-recording || AppState.recording-finalizing;
    out property <bool> capture-ready: !consultation-open && !calendar-open && !AppState.patient-action-pending && !AppState.patient-edit-open && !AppState.storage-busy && !AppState.storage-critical && AppState.is-streaming
        && AppState.selected-eye != 0 && (AppState.patient-id != ""
            || (AppState.patient-first-name == "" && AppState.patient-last-name == ""));
    out property <bool> capture-enabled: !AppState.recording-finalizing
        && (AppState.is-recording || AppState.capture-ready);
    out property <string> capture-label: AppState.recording-finalizing ? "Finalisation de la vidéo…"
        : AppState.is-recording ? "Arrêter l’enregistrement"
        : AppState.is-video-mode ? "Démarrer la vidéo" : "Capturer une photo";
    out property <string> capture-hint: AppState.recording-finalizing ? "Finalisation de la vidéo…"
        : AppState.is-recording ? "Enregistrement · " + AppState.recording-duration
        : AppState.storage-busy ? "Sauvegarde ou restauration en cours…"
        : AppState.storage-critical ? "Espace disque insuffisant"
        : AppState.patient-action-pending ? "Ouverture du dossier en cours…"
        : !AppState.is-streaming ? "En attente du flux caméra"
        : AppState.patient-id == "" && (AppState.patient-first-name != "" || AppState.patient-last-name != "") ? "Choisissez ou créez le dossier patient"
        : AppState.selected-eye == 0 ? "Choisissez l’œil gauche ou droit"
        : AppState.storage-low ? "Espace disque faible · vérifiez le dossier des captures"
        : AppState.patient-id == "" ? "Prêt · capture sans patient" : "Prêt pour la capture";

    public function capture() {
        if AppState.capture-enabled {
            if AppState.is-recording || AppState.is-video-mode { AppState.toggle-recording(); }
            else { AppState.trigger-capture(); }
        }
    }

