import { ThumbnailSizeControl } from "./thumbnail-size.slint";
import { AppComboBox } from "./combo-box.slint";
import { AppButton } from "./controls.slint";
import { Design } from "./theme.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";
import { AppState } from "./state.slint";

// Values remain beside labels, without stretching to match the settings form.
component DiagnosticRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> highlight: false;
    vertical-stretch: 0;
    spacing: 12px;
    Text {
        width: 104px;
        vertical-stretch: 0;
        text: root.label;
        color: Design.text-muted;
        font-size: 12px;
        wrap: word-wrap;
    }
    Text {
        min-width: 0px;
        horizontal-stretch: 1;
        vertical-stretch: 0;
        text: root.value == "" ? "—" : root.value;
        color: root.highlight ? Design.success : Design.text;
        font-size: 13px;
        font-weight: root.highlight ? 600 : 400;
        wrap: word-wrap;
    }
}

component SettingsField inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> browsable: false;
    callback browse;
    callback save(string);
    vertical-stretch: 0;
    spacing: 8px;
    Text {
        text: root.label;
        color: Design.text-secondary;
        font-size: 13px;
        font-weight: 600;
        vertical-stretch: 0;
    }
    HorizontalLayout {
        height: 40px;
        vertical-stretch: 0;
        spacing: 8px;
        field := LineEdit {
            min-width: 0px;
            horizontal-stretch: 1;
            height: 40px;
            enabled: root.enabled;
            text: root.value;
            accessible-label: root.label;
            placeholder-text: root.placeholder;
            changed has-focus => {
                AppState.focused-text-fields = Math.max(0,
                AppState.focused-text-fields + (self.has-focus ? 1 : -1));
            }
            accepted(value) => {
                if root.enabled && (value != root.value || AppState.settings-feedback-is-error) {
                    root.save(value);
                }
            }
        }
        AppButton {
            height: 40px;
            text: "Enregistrer";
            accessibility-label: "Enregistrer : " + root.label;
            enabled: root.enabled && (field.text != root.value || AppState.settings-feedback-is-error);
            clicked => { root.save(field.text); }
        }
        if root.browsable: AppButton {
            height: 40px;
            text: "Parcourir…";
            tooltip: root.value == "" ? "Choisir : " + root.label : root.value;
            accessibility-label: "Parcourir : " + root.label;
            enabled: root.enabled && !AppState.file-dialog-pending;
            clicked => { root.browse(); }
        }
    }
}

export component SettingsPage inherits Rectangle {
    private property <bool> stacked: root.width < 1040px;
    private property <length> available-width: max(0px, settings-scroll.visible-width - 48px);
    private property <length> settings-width: root.stacked ? root.available-width
    : (root.available-width - 24px) * 0.50;
    private property <length> diagnostics-width: root.stacked ? root.available-width
    : (root.available-width - 24px) * 0.50;

    function select-theme(mode: int) {
        if AppState.settings-theme != mode || AppState.settings-feedback-is-error {
            AppState.select-theme(mode);
        }
    }

    VerticalLayout {
        spacing: 0px;
        settings-scroll := ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                width: settings-scroll.visible-width;
                padding: 24px;
                spacing: 24px;
                alignment: start;

                VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 0;
                    Text {
                        text: "Paramètres";
                        font-family: Design.font-ui;
                        font-size: 24px;
                        font-weight: 600;
                        color: Design.text;
                        vertical-stretch: 0;
                    }
                    Text {
                        text: "Personnalisez les captures, l’affichage et vos images de référence.";
                        color: Design.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                        vertical-stretch: 0;
                    }
                    Text {
                        text: AppState.app-version == "" ? "Iriscope" : "Iriscope · version " + AppState.app-version;
                        color: Design.text-muted; font-size: 12px; vertical-stretch: 0;
                    }
                    Text {
                        text: AppState.update-message;
                        color: Design.text-secondary; font-size: 12px; wrap: word-wrap; vertical-stretch: 0;
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: start; vertical-stretch: 0;
                        AppButton {
                            compact: true; text: "Rechercher une mise à jour";
                            enabled: AppState.update-supported && !AppState.update-busy && !AppState.update-ready;
                            clicked => { AppState.check-update(); }
                        }
                        if AppState.update-available && !AppState.update-ready: AppButton {
                            compact: true; text: "Télécharger " + AppState.update-version;
                            enabled: !AppState.update-busy;
                            clicked => { AppState.download-update(); }
                        }
                        if AppState.update-ready: AppButton {
                            compact: true; text: "Installer et redémarrer";
                            enabled: !AppState.recording-busy && !AppState.storage-busy && !AppState.export-busy
                                && !AppState.patient-action-pending && !AppState.file-dialog-pending
                                && !AppState.viewer-review-dirty && !AppState.viewer-review-busy
                                && !AppState.consultation-dirty && !AppState.consultation-saving;
                            tooltip: "L’installation attend la fin des enregistrements et des sauvegardes.";
                            clicked => { AppState.install-update(); }
                        }
                        if AppState.update-busy: AppButton {
                            compact: true; quiet: true; text: "Annuler";
                            clicked => { AppState.cancel-update(); }
                        }
                        if AppState.update-busy && AppState.update-progress > 0: Text {
                            text: AppState.update-progress + " %";
                            font-size: 12px; color: Design.text-muted; vertical-alignment: center;
                        }
                    }
                }

                GridLayout {
                    spacing: 24px;
                    vertical-stretch: 0;

                    VerticalLayout {
                        row: 0;
                        col: 0;
                        width: root.settings-width;
                        spacing: 16px;
                        alignment: start;
                        vertical-stretch: 0;

                        Rectangle {
                            border-radius: Design.card-radius;
                            background: Design.surface;
                            border-width: 1px;
                            border-color: Design.border;
                            height: capture-content.preferred-height;
                            vertical-stretch: 0;
                            capture-content := VerticalLayout {
                                spacing: 16px;
                                padding: 20px;
                                alignment: start;
                                Text {
                                    text: "Fichiers de capture";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Design.text;
                                    vertical-stretch: 0;
                                }
                                SettingsField {
                                    label: "Dossier des captures";
                                    browsable: true;
                                    browse => { AppState.browse-settings-path(0); }
                                    value: AppState.settings-capture-directory;
                                    placeholder: "Chemin du dossier";
                                    enabled: !AppState.recording-busy && !AppState.storage-busy;
                                    save(value) => { AppState.update-capture-directory(value); }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    vertical-stretch: 0;
                                    AppButton {
                                        compact: true;
                                        text: "Ouvrir ce dossier";
                                        clicked => { AppState.open-capture-directory(); }
                                    }
                                }
                                Text { text: AppState.storage-status; color: AppState.storage-low ? Design.danger : Design.text-muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                                Text { text: "Sauvegarde complète : captures, dossiers et vidéos interrompues. La restauration crée un nouveau dossier et l’ouvre sans remplacer les captures actuelles."; color: Design.text-secondary; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                                HorizontalLayout { height: 36px; spacing: 8px; vertical-stretch: 0; alignment: start;
                                    AppButton { compact: true; text: "Sauvegarder"; enabled: !AppState.storage-busy && !AppState.export-busy && !AppState.file-dialog-pending && !AppState.recording-busy && !AppState.patient-action-pending; clicked => { AppState.backup-library(); } }
                                    AppButton { compact: true; text: "Restaurer…"; quiet: true; enabled: !AppState.storage-busy && !AppState.export-busy && !AppState.file-dialog-pending && !AppState.recording-busy && !AppState.patient-action-pending; clicked => { AppState.restore-library(); } }
                                    if AppState.storage-busy && !AppState.file-dialog-pending: AppButton {
                                        compact: true; text: AppState.storage-cancelling ? "Annulation…" : "Annuler";
                                        enabled: !AppState.storage-cancelling;
                                        clicked => { AppState.cancel-storage-operation(); }
                                    }
                                }
                                if AppState.storage-busy && AppState.storage-progress-known: Rectangle {
                                    height: 6px; vertical-stretch: 0; background: Design.control; border-radius: 3px;
                                    accessible-role: progress-indicator; accessible-value: AppState.storage-progress;
                                    accessible-label: "Progression de la sauvegarde ou restauration";
                                    accessible-value-minimum: 0; accessible-value-maximum: 100;
                                    Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * AppState.storage-progress / 100; background: Design.accent; border-radius: 3px; }
                                }
                                if AppState.storage-feedback != "": Text { text: AppState.storage-feedback; color: AppState.storage-feedback-error ? Design.danger : Design.text-secondary; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                                Text { text: AppState.backup-last-status; color: Design.text-secondary; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                                HorizontalLayout {
                                    height: 36px; spacing: Design.gap-small; vertical-stretch: 0; alignment: start;
                                    Text { text: "Rappel après 7 jours"; color: Design.text-secondary; font-size: 12px; vertical-alignment: center; }
                                    AppButton { compact: true; checkable: true; selected: AppState.backup-reminder-enabled; text: AppState.backup-reminder-enabled ? "Activé" : "Désactivé"; accessibility-label: "Rappel de sauvegarde après sept jours"; clicked => { AppState.set-backup-reminder(!AppState.backup-reminder-enabled); } }
                                }
                                if AppState.backup-reminder != "": Text { text: AppState.backup-reminder; color: Design.accent; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                                if AppState.export-feedback != "": Text { text: AppState.export-feedback; color: AppState.export-feedback-error ? Design.danger : Design.text-secondary; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                                if AppState.export-busy && !AppState.file-dialog-pending: HorizontalLayout {
                                    alignment: start; vertical-stretch: 0;
                                    AppButton { compact: true; text: AppState.export-cancelling ? "Annulation…" : "Annuler l’export MP4"; enabled: !AppState.export-cancelling; clicked => { AppState.cancel-video-export(); } }
                                }
                                Rectangle { height: 1px; vertical-stretch: 0; background: Design.border; }
                                SettingsField {
                                    label: "Modèle de nom des fichiers";
                                    value: AppState.settings-filename-template;
                                    placeholder: "{prenom}_{nom}_{oeil}_{date}_{heure}";
                                    save(value) => { AppState.update-filename-template(value); }
                                }
                                Text {
                                    text: "Requis : {prenom}, {nom}, {oeil}. Facultatifs : {date}, {heure}. Une capture reste possible sans nom de patient.";
                                    color: Design.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }
                                Text {
                                    text: "Les captures, leurs noms et l’index local ne sont pas chiffrés. Réservez l’accès à ce dossier aux personnes autorisées.";
                                    color: Design.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }
                            }
                        }

                        Rectangle {
                            border-radius: Design.card-radius;
                            background: Design.surface;
                            border-width: 1px;
                            border-color: Design.border;
                            height: reference-content.preferred-height;
                            vertical-stretch: 0;
                            reference-content := VerticalLayout {
                                spacing: 16px;
                                padding: 20px;
                                alignment: start;
                                Text {
                                    text: "Images de référence";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Design.text;
                                    vertical-stretch: 0;
                                }
                                Text {
                                    text: "Indiquez le chemin d’une image JPEG ou PNG. Vos références seront accessibles depuis la bibliothèque.";
                                    color: Design.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }
                                SettingsField {
                                    label: "Carte d’iridologie";
                                    browsable: true;
                                    browse => { AppState.browse-settings-path(1); }
                                    value: AppState.settings-iridology-map-path;
                                    placeholder: "Chemin vers une image JPEG ou PNG";
                                    save(value) => { AppState.update-iridology-map-path(value); }
                                }
                                SettingsField {
                                    label: "Planche de signes et symboles";
                                    browsable: true;
                                    browse => { AppState.browse-settings-path(2); }
                                    value: AppState.settings-iridology-symbols-path;
                                    placeholder: "Chemin vers une image JPEG ou PNG";
                                    save(value) => { AppState.update-iridology-symbols-path(value); }
                                }
                                Text {
                                    text: "Laissez un chemin vide pour retirer l’image de référence.";
                                    color: Design.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        row: root.stacked ? 1 : 0;
                        col: root.stacked ? 0 : 1;
                        width: root.diagnostics-width;
                        spacing: 16px; alignment: start; vertical-stretch: 0;
                        Rectangle {
                            border-radius: Design.card-radius;
                            background: Design.surface;
                            border-width: 1px;
                            border-color: Design.border;
                            height: display-content.preferred-height;
                            vertical-stretch: 0;
                            display-content := VerticalLayout {
                                spacing: 16px;
                                padding: 20px;
                                alignment: start;
                                Text {
                                    text: "Caméra";
                                    font-size: 16px;
                                    font-weight: 600;
                                    color: Design.text;
                                    vertical-stretch: 0;
                                }
                                VerticalLayout {
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    Text {
                                        text: "Qualité du direct et des vidéos";
                                        color: Design.text-secondary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-stretch: 0;
                                    }
                                    AppComboBox {
                                        height: 36px;
                                        vertical-stretch: 0;
                                        model: ["Maximale — résolution", "Équilibrée", "Fluide — images par seconde"];
                                        current-index <=> AppState.settings-video-quality;
                                        enabled: !AppState.recording-busy && !AppState.storage-busy;
                                        accessible-label: "Qualité du direct et des vidéos";
                                        selected(value) => {
                                            AppState.update-video-quality(value == "Équilibrée" ? 1
                                            : value == "Fluide — images par seconde" ? 2 : 0);
                                        }
                                    }
                                    Text {
                                        text: AppState.recording-busy
                                        ? "La qualité et le dossier seront modifiables une fois la vidéo terminée."
                                        : "Changer de qualité redémarre brièvement le flux. Le mode actif est indiqué dans le diagnostic.";
                                        color: Design.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        vertical-stretch: 0;
                                    }
                                }
                            }
                        }
                        Rectangle {
                            border-radius: Design.card-radius; background: Design.surface;
                            border-width: 1px; border-color: Design.border;
                            height: interface-content.preferred-height; vertical-stretch: 0;
                            interface-content := VerticalLayout { padding: 20px; spacing: 12px; alignment: start;
                                Text {text: "Interface et affichage"; font-size: 16px; font-weight: 600; color: Design.text; vertical-stretch: 0;}
                                VerticalLayout {
                                    vertical-stretch: 0;
                                    spacing: 8px;
                                    Text {
                                        text: "Thème de l’interface";
                                        color: Design.text-secondary;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-stretch: 0;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        spacing: 8px;
                                        vertical-stretch: 0;
                                        AppButton {
                                            text: "Système";
                                            checkable: true;
                                            selected: AppState.settings-theme == 0;
                                            clicked => { root.select-theme(0); }
                                        }
                                        AppButton {
                                            text: "Clair";
                                            checkable: true;
                                            selected: AppState.settings-theme == 1;
                                            clicked => { root.select-theme(1); }
                                        }
                                        AppButton {
                                            text: "Sombre";
                                            checkable: true;
                                            selected: AppState.settings-theme == 2;
                                            clicked => { root.select-theme(2); }
                                        }
                                    }
                                }

                                HorizontalLayout { height: 36px; spacing: 12px; vertical-stretch: 0;
                                    Text {min-width:0px; horizontal-stretch:1; text:"Mémoriser la disposition"; color:Design.text; wrap:word-wrap; vertical-alignment:center;}
                                    AppButton {compact:true; checkable:true; selected:AppState.remember-layout; text:AppState.remember-layout ? "Activée" : "Désactivée"; clicked=>{AppState.remember-layout=!AppState.remember-layout;AppState.interface-edited();}}
                                }
                                Text {text:"Panneaux ouverts, largeurs et vue grille ou liste sont retrouvés au prochain lancement. Faites glisser les séparateurs pour ajuster les panneaux."; color:Design.text-muted; font-size:12px; wrap:word-wrap; vertical-stretch:0;}
                                HorizontalLayout { height: 36px; spacing: 12px; vertical-stretch: 0;
                                    Text {min-width:0px; horizontal-stretch:1; text:"Image seule à l’ouverture des photos"; color:Design.text; wrap:word-wrap; vertical-alignment:center;}
                                    AppButton {compact:true; checkable:true; selected:AppState.image-only; text:AppState.image-only ? "Activée" : "Désactivée"; clicked=>{AppState.toggle-image-only();}}
                                }
                                Text {text:"Les commandes se masquent après 3 secondes. Bougez la souris ou utilisez « Commandes » pour les retrouver. Échap revient à la vue complète."; color:Design.text-muted; font-size:12px; wrap:word-wrap; vertical-stretch:0;}
                                VerticalLayout { spacing: 8px; vertical-stretch: 0;
                                    Text {text:"Taille des miniatures"; color:Design.text-secondary; font-size:13px; font-weight:600;}
                                    ThumbnailSizeControl { height: 36px; }
                                }
                                HorizontalLayout { height: 36px; spacing: 12px; vertical-stretch: 0;
                                    Text {min-width:0px; horizontal-stretch:1; text:"Montrer l’iris au patient"; color:Design.text; wrap:word-wrap; vertical-alignment:center;}
                                    AppButton {compact:true; text:"Présenter"; clicked=>{AppState.toggle-presentation();}}
                                }
                                Text {text:"La présentation masque les noms, numéros de dossier, fichiers, notes et annotations. Les indicateurs de capture et les erreurs restent visibles. Quittez ce mode pour accéder aux dossiers."; color:Design.text-muted; font-size:12px; wrap:word-wrap; vertical-stretch:0;}
                                AppButton {text:"Réinitialiser la disposition"; compact:true; clicked=>{AppState.reset-interface();}}
                            }
                        }
                        Rectangle {
                            border-radius: Design.card-radius;
                            background: Design.surface;
                            border-width: 1px;
                            border-color: Design.border;
                            height: diagnostic-content.preferred-height;
                            vertical-stretch: 0;

                            diagnostic-content := VerticalLayout {
                                spacing: 16px;
                                padding: 20px;
                                alignment: start;
                                HorizontalLayout { height: 36px; spacing: 8px; vertical-stretch: 0;
                                    Text { min-width: 0px; horizontal-stretch: 1;
                                        text: "Diagnostic caméra";
                                        font-size: 16px;
                                        font-weight: 600;
                                        color: Design.text;
                                        vertical-stretch: 0;
                                    }
                                    AppButton {compact:true; text:AppState.advanced-settings-expanded ? "Replier" : "Détails"; checkable:true; selected:AppState.advanced-settings-expanded; clicked=>{AppState.advanced-settings-expanded=!AppState.advanced-settings-expanded;AppState.interface-edited();}}
                                }
                                Text {
                                    text: AppState.status-text == "" ? "Iridoscope déconnecté" : AppState.status-text;
                                    color: AppState.camera-connected ? Design.success : Design.text-muted;
                                    font-size: 13px;
                                    font-weight: 600;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }

                                if !AppState.camera-connected: Text {
                                    text: "Branchez l’iridoscope pour consulter les informations du périphérique et du flux.";
                                    color: Design.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }

                                if AppState.camera-connected && AppState.advanced-settings-expanded: VerticalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    vertical-stretch: 0;
                                    DiagnosticRow { label: "Périphérique"; value: AppState.diagnostics.device-name; }
                                    DiagnosticRow { label: "Identifiant"; value: AppState.diagnostics.device-id; }
                                    DiagnosticRow { label: "Pilote"; value: AppState.diagnostics.backend-name; }
                                    DiagnosticRow { label: "Identité USB"; value: AppState.diagnostics.usb-info; }
                                    Rectangle { height: 1px; vertical-stretch: 0; background: Design.border; }
                                    DiagnosticRow { label: "Format"; value: AppState.diagnostics.active-format; }
                                    DiagnosticRow { label: "Résolution"; value: AppState.diagnostics.active-resolution; }
                                    DiagnosticRow { label: "Cadence du mode"; value: AppState.diagnostics.active-fps; }
                                    DiagnosticRow {
                                        label: "Cadence mesurée";
                                        value: AppState.is-streaming ? AppState.diagnostics.measured-fps : "Flux en pause";
                                        highlight: AppState.is-streaming;
                                    }
                                    DiagnosticRow { label: "Décodage"; value: AppState.diagnostics.decode-time-ms; }
                                    DiagnosticRow { label: "Images reçues"; value: "" + AppState.diagnostics.frame-count; }
                                    DiagnosticRow { label: "Images ignorées"; value: "" + AppState.diagnostics.dropped-frames; }
                                }

                                Rectangle { height: 1px; vertical-stretch: 0; background: Design.border; }
                                Text {
                                    text: AppState.hardware-button-status;
                                    color: Design.text-muted;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    vertical-stretch: 0;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Keep save results visible when the form is scrolled to the references.
        if AppState.settings-feedback != "": Rectangle {
            height: feedback-content.preferred-height;
            vertical-stretch: 0;
            background: AppState.settings-feedback-is-error ? Design.error-surface : Design.success-surface;
            border-width: 1px;
            border-color: AppState.settings-feedback-is-error ? Design.danger : Design.border;
            accessible-role: groupbox;
            accessible-label: AppState.settings-feedback;
            feedback-content := HorizontalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                padding-left: 24px;
                padding-right: 24px;
                Text {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    text: AppState.settings-feedback;
                    color: AppState.settings-feedback-is-error ? Design.danger : Design.success;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
            }
        }
    }
}
