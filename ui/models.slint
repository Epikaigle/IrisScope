export struct DiagnosticData {
    device-name: string,
    device-id: string,
    backend-name: string,
    usb-info: string,
    active-format: string,
    active-resolution: string,
    active-fps: string,
    measured-fps: string,
    decode-time-ms: string,
    frame-count: int,
    dropped-frames: int,
}

export struct AnnotationData {
    kind: int,
    x: float, y: float, end-x: float, end-y: float,
    text: string,
}

export struct ComparisonCandidateData {
    path: string, version: string, caption: string, thumbnail: image,
}

export struct LibraryItemData {
    id: string,
    file-path: string,
    file-version: string,
    title: string,
    date-time: string,
    dossier-number: string,
    eye-label: string,
    thumbnail: image,
    has-thumbnail: bool,
    is-video: bool,
    can-open-in-app: bool,
    is-current-patient: bool,
}

export struct PatientCandidateData {
    id: string,
    dossier-number: string,
    first-name: string,
    last-name: string,
    last-capture: string,
}

export struct CameraControlUiData {
    key: string,
    name: string,
    kind: int, // 0: slider integer, 1: boolean, 2: menu, 3: large integer
    minimum: float,
    maximum: float,
    step: float,
    value: float,
    value-label: string,
    boolean-value: bool,
    menu-label: string,
    menu-options: [string],
    menu-index: int,
    read-only: bool,
}

export struct CalendarDayData {day:int,date:string,enabled:bool,selected:bool,}
export struct ConsultationDayData {date:string,label:string,left:int,right:int,videos:int,}
export struct SessionPhotoData {path:string,version:string,caption:string,eye:int,retained:bool,thumbnail:image,}
