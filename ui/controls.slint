import { Design } from "./theme.slint";

// Preserve the input method across popup focus transfers. A mouse-opened menu
// must not produce a keyboard outline when it returns focus to its button.
export global InputMode {
    in-out property <bool> keyboard-navigation: true;
}

// A passive overlay keeps tooltips from capturing clicks or keyboard focus.
export global HelpState {
    in-out property <string> text: "";
    in-out property <length> x;
    in-out property <length> y;
}

export component Tooltip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    private property <bool> shown: false;
    width: 0px;
    height: 0px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    changed active => {
        if !root.active && root.shown {
            if HelpState.text == root.text { HelpState.text = ""; }
            root.shown = false;
        }
    }
    changed text => {
        if root.shown { HelpState.text = ""; root.shown = false; }
    }
    Timer {
        interval: 650ms;
        running: root.active && root.text != "" && !root.shown;
        triggered => {
            root.shown = true;
            HelpState.x = root.absolute-position.x;
            HelpState.y = root.absolute-position.y;
            HelpState.text = root.text;
        }
    }
}

export component HelpOverlay inherits Rectangle {
    in property <length> available-width;
    in property <length> available-height;
    visible: HelpState.text != "";
    width: min(360px, root.available-width - 24px);
    height: message.preferred-height + 20px;
    x: clamp(HelpState.x, 12px, root.available-width - self.width - 12px);
    y: clamp(HelpState.y + self.height > root.available-height - 12px ? HelpState.y - self.height - 42px : HelpState.y, 12px, root.available-height - self.height - 12px);
    background: Design.overlay-panel;
    border-color: Design.overlay-border;
    border-width: 1px;
    border-radius: Design.control-radius;
    message := Text {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        text: HelpState.text;
        color: Design.overlay-text;
        font-size: 13px;
        wrap: word-wrap;
    }
}

export component HelpText inherits Text {
    in property <string> full-text: self.text;
    hover := TouchArea { }
    Tooltip { y: root.height + 6px; text: root.full-text; active: hover.has-hover && !hover.pressed; }
}

// A single button treatment keeps the native UI consistent across platforms.
export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> accessibility-label: text;
    in property <string> tooltip: root.elide-text ? root.text : "";
    in property <bool> collapse-when-hidden: false;
    private property <bool> collapsed: root.collapse-when-hidden && !root.visible;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> compact: false;
    // Long device-provided labels may shrink without widening the whole panel.
    in property <bool> elide-text: false;
    in property <bool> wrap-text: false;
    in property <bool> left-aligned: false;
    in property <bool> overlay: false;
    in property <bool> danger: false;
    in property <bool> checkable: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: keyboard-focus.has-focus;
    out property <bool> keyboard-focus-visible: root.has-focus && InputMode.keyboard-navigation;
    out property <bool> active-interaction: root.visible && (pointer.has-hover || root.pressed
        || root.keyboard-focus-visible);
    callback clicked;

    private property <color> foreground: root.overlay ? Design.overlay-text : Design.text;
    private property <color> secondary-foreground: root.overlay ? Design.overlay-text-muted : Design.text-muted;
    private property <color> button-border: root.overlay ? Design.overlay-border : Design.border;
    private property <color> button-surface: root.overlay ? Design.overlay-control : Design.control;
    private property <color> button-hover: root.overlay ? Design.overlay-control-hover : Design.control-hover;
    private property <color> button-pressed: root.overlay ? Design.overlay-control-pressed : Design.control-pressed;
    private property <color> selection-surface: root.overlay ? Design.overlay-selected : Design.accent-soft;
    private property <color> selection-hover: root.overlay ? Design.overlay-selected-hover : Design.accent-soft-hover;
    private property <color> selection-pressed: root.overlay ? Design.overlay-selected-pressed : Design.accent-soft-pressed;
    private property <bool> pressed: pointer.pressed || keyboard-focus.activation-key != "";
    private property <length> horizontal-padding: root.overlay ? Design.overlay-padding : root.compact ? 10px : 14px;
    min-width: root.collapsed ? 0px : max(root.compact ? Design.compact-control-height : Design.control-height,
        root.elide-text ? 0px : button-text.preferred-width + 2 * root.horizontal-padding);
    preferred-width: root.collapsed ? 0px : max(root.min-width, button-text.preferred-width + 2 * root.horizontal-padding);
    min-height: root.collapsed ? 0px : max(root.compact ? Design.compact-control-height : Design.control-height, button-text.preferred-height + 10px);
    preferred-height: root.min-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    forward-focus: keyboard-focus;
    border-radius: Design.control-radius;
    border-width: 1px;
    border-color: !root.enabled ? root.button-border
        : root.danger ? (root.overlay ? Design.overlay-danger : Design.danger)
        : root.selected ? (root.overlay ? Design.overlay-accent : Design.accent)
        : root.primary ? (root.overlay ? Design.overlay-accent : Design.accent)
        : root.quiet ? (pointer.has-hover ? root.button-border : transparent)
        : root.button-border;
    background: !root.enabled ? (root.overlay ? Design.overlay-control : Design.control-disabled)
        : root.danger ? (root.overlay ? (root.pressed ? Design.overlay-danger-pressed : pointer.has-hover ? Design.overlay-danger-hover : Design.overlay-danger-surface) : Design.error-surface)
        : root.selected ? (root.pressed ? root.selection-pressed : pointer.has-hover ? root.selection-hover : root.selection-surface)
        : root.primary ? (root.overlay ? (root.pressed ? root.button-pressed : pointer.has-hover ? root.button-hover : root.button-surface)
            : root.pressed ? Design.accent-pressed : pointer.has-hover ? Design.accent-hover : Design.accent)
        : root.quiet ? (root.pressed ? root.button-pressed : pointer.has-hover ? root.button-hover : transparent)
        : root.pressed ? root.button-pressed : pointer.has-hover ? root.button-hover : root.button-surface;
    animate background, border-color { duration: 120ms; }

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.accessibility-label;
    accessible-checkable: root.checkable;
    accessible-checked: root.selected;
    accessible-description: root.selected ? "Sélectionné" : "";
    accessible-action-default => { if root.enabled { root.clicked(); } }

    button-text := Text {
            x: root.horizontal-padding;
            y: 0px;
            width: max(0px, parent.width - 2 * root.horizontal-padding);
            height: parent.height;
            min-width: 0px;
            overflow: root.elide-text && !root.wrap-text ? elide : clip;
            wrap: root.wrap-text ? word-wrap : no-wrap;
            text: root.text;
            color: !root.enabled ? root.secondary-foreground : root.danger ? (root.overlay ? Design.overlay-danger : Design.danger)
                : root.selected ? (root.overlay ? Design.overlay-accent : Design.accent)
                : root.primary ? (root.overlay ? root.foreground : Design.accent-ink) : root.foreground;
            font-family: Design.font-ui;
            font-size: root.compact && !root.overlay ? 12px : Design.control-font-size;
            font-weight: Design.control-font-weight;
            letter-spacing: 0.1px;
            horizontal-alignment: root.left-aligned ? left : center;
            vertical-alignment: center;
    }

    pointer := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                InputMode.keyboard-navigation = false;
                keyboard-focus.focus();
            }
        }
        clicked => { root.clicked(); }
    }
    Tooltip { y: root.height + 6px; text: root.tooltip; active: root.visible && pointer.has-hover && !pointer.pressed; }

    keyboard-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        private property <string> activation-key: "";
        changed has-focus => {
            if !self.has-focus { self.activation-key = ""; }
        }
        changed enabled => { if !self.enabled { self.activation-key = ""; } }
        key-pressed(event) => {
            InputMode.keyboard-navigation = true;
            if root.enabled && (event.text == " " || event.text == "\n") {
                if !event.repeat && self.activation-key == "" { self.activation-key = event.text; }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (event.text == " " || event.text == "\n") {
                if self.activation-key == event.text {
                    self.activation-key = "";
                    if root.enabled { root.clicked(); }
                }
                return accept;
            }
            return reject;
        }
    }

    // Mouse selection already has its border and hover state. Keep the extra
    // focus indicator for keyboard navigation only.
    if root.keyboard-focus-visible && root.enabled: Rectangle {
        x: 2px;
        y: 2px;
        width: max(0px, parent.width - 4px);
        height: max(0px, parent.height - 4px);
        border-radius: max(0px, Design.control-radius - 2px);
        border-width: 2px;
        border-color: root.overlay ? Design.overlay-accent : Design.focus;
        background: transparent;
    }
}

// Non-interactive camera information uses the same metrics as overlay buttons.
export component OverlayBadge inherits Rectangle {
    in property <string> text;
    in property <bool> recording: false;
    preferred-width: max(Design.control-height, badge-text.preferred-width + 2 * Design.overlay-padding + (root.recording ? 14px : 0px));
    width: self.preferred-width;
    height: Design.control-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Design.control-radius;
    border-width: 1px;
    border-color: root.recording ? Design.overlay-danger : Design.overlay-border;
    background: Design.overlay-control;
    if root.recording: Rectangle {
        x: Design.overlay-padding;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Design.overlay-danger;
    }
    badge-text := Text {
        x: Design.overlay-padding + (root.recording ? 14px : 0px);
        y: 0px;
        width: max(0px, parent.width - self.x - Design.overlay-padding);
        height: parent.height;
        min-width: 0px;
        text: root.text;
        color: Design.overlay-text;
        font-family: Design.font-ui;
        font-size: Design.control-font-size;
        font-weight: Design.control-font-weight;
        letter-spacing: 0.1px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AppSlider inherits Rectangle {
    in property <string> label: "";
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in property <bool> overlay: false;
    in-out property <float> value: minimum;
    out property <bool> has-focus: keyboard-focus.has-focus;
    out property <bool> active-interaction: root.visible && (pointer.has-hover || pointer.pressed || root.has-focus);
    callback changed;
    callback released(float);

    private property <float> range: max(0.0001, root.maximum - root.minimum);
    private property <float> effective-step: max(0.0001, root.step);
    private property <float> final-step-value: root.minimum + floor(max(0, root.maximum - root.minimum) / root.effective-step) * root.effective-step;
    private property <float> fraction: clamp((root.value - root.minimum) / root.range, 0, 1);

    min-width: 60px;
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: transparent;
    forward-focus: keyboard-focus;

    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.effective-step;
    accessible-action-set-value(v) => {
        if root.enabled && v.is-float() {
            root.set-value(v.to-float());
            root.released(root.value);
        }
    }
    accessible-action-increment => {
        if root.enabled { root.set-value(root.value + root.effective-step); root.released(root.value); }
    }
    accessible-action-decrement => {
        if root.enabled { root.set-value(root.value - root.effective-step); root.released(root.value); }
    }

    public function set-value(next: float) {
        let bounded = clamp(next, root.minimum, root.maximum);
        let adjusted = clamp(root.minimum + round((bounded - root.minimum) / root.effective-step) * root.effective-step, root.minimum, root.final-step-value);
        if root.value != adjusted {
            root.value = adjusted;
            root.changed();
        }
    }

    rail := Rectangle {
        x: 9px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 18px;
        height: 4px;
        border-radius: 2px;
        background: root.overlay ? Design.overlay-border : Design.border;
    }

    Rectangle {
        x: rail.x;
        y: rail.y;
        width: rail.width * root.fraction;
        height: rail.height;
        border-radius: rail.border-radius;
        background: root.enabled ? (root.overlay ? Design.overlay-accent : Design.accent) : Design.text-muted;
    }

    Rectangle {
        x: rail.x + rail.width * root.fraction - 9px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: root.has-focus && InputMode.keyboard-navigation ? 3px : 2px;
        border-color: root.has-focus && InputMode.keyboard-navigation ? (root.overlay ? Design.overlay-text : Design.focus) : (root.overlay ? Design.overlay-control : Design.surface);
        background: root.enabled ? (root.overlay ? Design.overlay-accent : pointer.pressed ? Design.accent-hover : Design.accent) : Design.text-muted;
    }

    pointer := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if event.button != PointerEventButton.left { return; }
            if event.kind == PointerEventKind.down {
                InputMode.keyboard-navigation = false;
                keyboard-focus.focus();
                root.set-value(root.minimum + root.range * clamp((self.mouse-x - rail.x) / rail.width, 0, 1));
            }
            if event.kind == PointerEventKind.up { root.released(root.value); }
        }
        moved => {
            if self.pressed {
                root.set-value(root.minimum + root.range * clamp((self.mouse-x - rail.x) / rail.width, 0, 1));
            }
        }
    }

    keyboard-focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            InputMode.keyboard-navigation = true;
            if !root.enabled { return reject; }
            if event.text == Key.RightArrow {
                root.set-value(root.value + root.effective-step);
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.set-value(root.value - root.effective-step);
                return accept;
            }
            if event.text == Key.Home {
                root.set-value(root.minimum);
                return accept;
            }
            if event.text == Key.End {
                root.set-value(root.maximum);
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.RightArrow || event.text == Key.LeftArrow
                || event.text == Key.Home || event.text == Key.End {
                root.released(root.value);
                return accept;
            }
            return reject;
        }
    }
}
