import { AppButton, AppSlider } from "./controls.slint";
import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { AppState } from "./state.slint";
import { Design } from "./theme.slint";

export component CameraPreview inherits Rectangle {
    min-height: 0px;
    min-width: 0px;
    horizontal-stretch: 1;
    clip: true;
    border-radius: AppState.iris-fullscreen ? 0px : Design.panel-radius;
    background: Design.preview;

    if AppState.is-streaming: Image {
        source: AppState.live-frame;
        private property <bool> quarter-turn:
            AppState.rotation-angle == 90 || AppState.rotation-angle == 270;
        private property <float> zoom-factor: AppState.zoom-level / 100.0;

        width: (self.quarter-turn ? parent.height : parent.width)
            * self.zoom-factor;
        height: (self.quarter-turn ? parent.width : parent.height)
            * self.zoom-factor;
        x: (parent.width - self.width) / 2 + AppState.zoom-pan-x;
        y: (parent.height - self.height) / 2 + AppState.zoom-pan-y;
        image-fit: contain;

        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: AppState.rotation-angle * 1deg;
        transform-scale-x: AppState.mirror-horizontal ? -100% : 100%;
        transform-scale-y: AppState.mirror-vertical ? -100% : 100%;
    }

    pan-area := TouchArea {
        enabled: AppState.is-streaming;
        private property <length> pan-start-x;
        private property <length> pan-start-y;

        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                AppState.show-viewport-controls();
            }
        }

        changed pressed => {
            if self.pressed {
                self.pan-start-x = AppState.zoom-pan-x;
                self.pan-start-y = AppState.zoom-pan-y;
            }
        }

        moved => {
            if self.pressed && AppState.zoom-level > 100 {
                AppState.zoom-pan-x = self.pan-start-x + self.mouse-x - self.pressed-x;
                AppState.zoom-pan-y = self.pan-start-y + self.mouse-y - self.pressed-y;
            }
        }

        scroll-event(event) => {
            if event.delta-y == 0 { return reject; }
            AppState.zoom-level = Math.max(100, Math.min(200,
                AppState.zoom-level + (event.delta-y > 0 ? 10 : -10)));
            AppState.zoom-pan-x = 0px;
            AppState.zoom-pan-y = 0px;
            return accept;
        }
    }

    AppButton {
        x: parent.width - self.width - 16px;
        y: AppState.is-frozen ? 56px : 16px;
        height: 40px;
        visible: AppState.viewport-controls-visible;
        text: AppState.iris-fullscreen ? "Quitter le plein écran" : "Plein écran";
        clicked => {
            AppState.image-controls-open = false;
            AppState.iris-fullscreen = !AppState.iris-fullscreen;
            AppState.show-viewport-controls();
        }
    }

    if !AppState.sidebar-visible && !AppState.iris-fullscreen: AppButton {
        x: 12px;
        y: AppState.is-recording || AppState.session-photo-count > 0 ? 56px : 16px;
        height: 40px;
        text: "▶ Panneau";
        clicked => { AppState.sidebar-visible = true; }
    }

    if AppState.iris-fullscreen: AppButton {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 20px;
        height: 48px;
        visible: AppState.viewport-controls-visible;
        text: AppState.recording-finalizing ? "Finalisation de la vidéo…"
            : AppState.is-recording ? "■ Arrêter la vidéo"
            : AppState.is-video-mode ? "● Démarrer la vidéo"
            : "Capturer une photo";
        primary: true;
        enabled: !AppState.recording-finalizing && (AppState.is-recording
            || (AppState.is-streaming && AppState.selected-eye != 0
                && (AppState.patient-id != ""
                    || (AppState.patient-first-name == "" && AppState.patient-last-name == ""))));
        clicked => {
            if AppState.is-recording || AppState.is-video-mode {
                AppState.toggle-recording();
            } else {
                AppState.trigger-capture();
            }
        }
    }

    if AppState.is-streaming && AppState.show-iridology-grid: Rectangle {
        width: Math.min(parent.height - 32px, 480px);
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 1.5px;
        border-color: #d8bb87bb;
    }

    if !AppState.is-streaming: VerticalBox {
        alignment: center;
        spacing: Design.gap;

        HorizontalBox {
            height: 84px;
            alignment: center;
            Rectangle {
                width: 72px;
                height: 72px;
                border-radius: 36px;
                border-width: 1px;
                border-color: Design.border;
                background: Design.surface-sunken;
                Rectangle {
                    x: 17px;
                    y: 17px;
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    border-width: 2px;
                    border-color: Design.accent;
                }
                Rectangle {
                    x: 31px;
                    y: 31px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Design.accent;
                }
            }
        }

        Text {
            text: "APERÇU CAMÉRA";
            color: Design.accent;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.6px;
            horizontal-alignment: center;
        }

        Text {
            text: AppState.camera-connected ? "Démarrage du flux en cours..." : "DE400 non détecté";
            color: Design.text;
            font-family: Design.font-display;
            font-size: 30px;
            horizontal-alignment: center;
        }
        Text {
            text: AppState.status-text;
            color: Design.text-muted;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    // Shutter flash effect
    Rectangle {
        width: 100%;
        height: 100%;
        background: Design.text;
        opacity: AppState.shutter-flash-opacity;
        animate opacity { duration: 180ms; easing: ease-out; }
    }

    // Recording overlay indicator
    if AppState.is-recording: Rectangle {
        x: 16px;
        y: 16px;
        width: 120px;
        height: 32px;
        border-radius: 16px;
        background: Design.error-surface;

        HorizontalBox {
            alignment: center;
            spacing: 6px;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: Design.danger;
            }

            Text {
                text: "REC " + AppState.recording-duration;
                color: Design.text;
                font-size: 14px;
                font-weight: 700;
            }
        }
    }

    // Session photo count badge
    if AppState.session-photo-count > 0: Rectangle {
        x: AppState.is-recording ? 148px : 16px;
        y: 16px;
        width: 130px;
        height: 32px;
        border-radius: 16px;
        background: Design.surface-sunken;
        border-width: 1.5px;
        border-color: Design.accent;

        HorizontalBox {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;
            spacing: 6px;

            Text {
                text: "📸 " + AppState.session-photo-count + (AppState.session-photo-count > 1 ? " photos" : " photo");
                color: Design.accent;
                font-size: 13px;
                font-weight: 700;
            }
        }
    }

    // Frozen image indicator
    if AppState.is-frozen: Rectangle {
        x: parent.width - 216px;
        y: 16px;
        width: 200px;
        height: 32px;
        border-radius: 16px;
        background: Design.info-surface;
        border-width: 1px;
        border-color: Design.accent;

        HorizontalBox {
            alignment: center;
            Text {
                text: "❄ Image Figée";
                color: Design.text;
                font-size: 13px;
                font-weight: 700;
            }
        }
    }

    if AppState.image-controls-open: Rectangle {
        x: 16px;
        y: AppState.is-recording || AppState.session-photo-count > 0 ? 56px : 16px;
        width: 324px;
        height: AppState.camera-controls.length == 0 ? 176px
            : parent.height - self.y - 16px < 360px
                ? parent.height - self.y - 16px : 360px;
        border-radius: Design.card-radius;
        border-width: 1px;
        border-color: Design.border-strong;
        background: Design.overlay-panel;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000088;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {}
        }

        VerticalBox {
            padding: 12px;
            spacing: 8px;
            HorizontalBox {
                height: 40px;
                vertical-stretch: 0;
                alignment: space-between;
                Text {
                    text: "Réglages image";
                    color: Design.overlay-text;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                AppButton {
                    height: 40px;
                    text: "Fermer";
                    clicked => { AppState.image-controls-open = false; }
                }
            }
            Text {
                height: 36px;
                vertical-stretch: 0;
                text: "L'image change en direct. Vos choix sont conservés.";
                color: Design.overlay-text-secondary;
                font-size: 11px;
                wrap: word-wrap;
            }
            Rectangle { height: 1px; vertical-stretch: 0; background: Design.border; }

            if AppState.camera-controls.length == 0: Text {
                text: AppState.camera-connected
                    ? "Cette caméra ne propose aucun réglage d'image accessible."
                    : "Branchez l'iridoscope pour régler l'image.";
                color: Design.overlay-text-secondary;
                wrap: word-wrap;
            }

            if AppState.camera-controls.length > 0: ScrollView {
                min-height: 0px;
                vertical-stretch: 1;
                VerticalBox {
                    spacing: 6px;
                    for control in AppState.camera-controls: Rectangle {
                        height: 100px;
                        border-radius: 6px;
                        background: Design.surface-raised;
                        VerticalBox {
                            padding: 8px;
                            spacing: 5px;
                            HorizontalBox {
                                height: 28px;
                                vertical-stretch: 0;
                                alignment: space-between;
                                Text {
                                    height: 28px;
                                    text: control.name;
                                    color: Design.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                if control.read-only: Text {
                                    height: 28px;
                                    text: "Lecture seule";
                                    color: Design.text-secondary;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                            if control.kind == 0: HorizontalBox {
                                height: 40px;
                                vertical-stretch: 0;
                                spacing: 6px;
                                AppSlider {
                                    label: control.name;
                                    horizontal-stretch: 1;
                                    minimum: control.minimum;
                                    maximum: control.maximum;
                                    value: control.value;
                                    enabled: !control.read-only;
                                    changed => { AppState.set-camera-control-value(control.key, self.value); }
                                }
                                Text {
                                    width: 58px;
                                    text: control.value-label;
                                    color: Design.text;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                            if control.kind == 3: HorizontalBox {
                                height: 40px;
                                vertical-stretch: 0;
                                spacing: 6px;
                                AppButton {
                                    height: 40px;
                                    text: "−";
                                    accessibility-label: "Diminuer " + control.name;
                                    enabled: !control.read-only;
                                    clicked => { AppState.step-camera-control(control.key, -1); }
                                }
                                Text {
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    text: control.value-label;
                                    color: Design.text;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                AppButton {
                                    height: 40px;
                                    text: "+";
                                    accessibility-label: "Augmenter " + control.name;
                                    enabled: !control.read-only;
                                    clicked => { AppState.step-camera-control(control.key, 1); }
                                }
                            }
                            if control.kind == 1: AppButton {
                                height: 40px;
                                vertical-stretch: 0;
                                text: control.boolean-value ? "Activé" : "Désactivé";
                                enabled: !control.read-only;
                                clicked => { AppState.set-camera-control-bool(control.key, !control.boolean-value); }
                            }
                            if control.kind == 2: AppButton {
                                height: 40px;
                                vertical-stretch: 0;
                                text: control.menu-label;
                                enabled: !control.read-only;
                                clicked => { AppState.cycle-camera-control-menu(control.key); }
                            }
                        }
                    }
                }
            }
            if AppState.camera-controls.length > 0: AppButton {
                height: 40px;
                vertical-stretch: 0;
                text: "Rétablir les valeurs d'origine";
                enabled: AppState.camera-controls.length > 0;
                clicked => { AppState.reset-camera-controls(); }
            }
        }
    }

                }
