import { ZoomControl } from "./zoom-control.slint";
import { MirrorControl } from "./mirror-control.slint";
import { RotationControl } from "./rotation-control.slint";
import { AppComboBox } from "./combo-box.slint";
import { AppButton, AppSlider, HelpText, OverlayBadge } from "./controls.slint";
import { ScrollView } from "std-widgets.slint";
import { AppState } from "./state.slint";
import { Design } from "./theme.slint";

export component CameraPreview inherits Rectangle {
    min-height: 0px;
    min-width: 0px;
    horizontal-stretch: 1;
    clip: true;
    border-radius: AppState.iris-fullscreen ? 0px : Design.panel-radius;
    background: Design.surface;
    private property <bool> compact-tools: root.width < 860px;
    private property <length> pan-limit-x: max(0px, image-surface.width * (AppState.zoom-level / 100.0 - 1) / 2);
    private property <length> pan-limit-y: max(0px, image-surface.height * (AppState.zoom-level / 100.0 - 1) / 2);
    changed pan-limit-x => { AppState.zoom-pan-x = clamp(AppState.zoom-pan-x, -root.pan-limit-x, root.pan-limit-x); }
    changed pan-limit-y => { AppState.zoom-pan-y = clamp(AppState.zoom-pan-y, -root.pan-limit-y, root.pan-limit-y); }
    private property <length> tools-height: AppState.iris-fullscreen ? 0px : root.compact-tools ? 92px : 48px;
    private property <bool> viewport-interacting: fullscreen-exit.active-interaction
        || viewport-capture.active-interaction;
    changed viewport-interacting => { AppState.viewport-controls-interacting = root.viewport-interacting; }

    image-surface := Rectangle {
        x: 0px;
        y: 0px;
        accessible-role: groupbox;
        accessible-label: "Aperçu caméra. Utilisez les flèches pour déplacer l'image agrandie.";
        forward-focus: live-pan-focus;
        width: 100%;
        height: parent.height - root.tools-height;
        clip: true;
        background: Design.preview;

        if AppState.is-streaming: Image {
            source: AppState.live-frame;
            private property <float> zoom-factor: AppState.zoom-level / 100.0;
            private property <float> cosine: abs(cos(AppState.rotation-angle * 1deg));
            private property <float> sine: abs(sin(AppState.rotation-angle * 1deg));
            private property <float> source-width: max(1, AppState.live-frame.width);
            private property <float> source-height: max(1, AppState.live-frame.height);
            private property <length> fit-pixel: min(parent.width / (self.source-width*self.cosine + self.source-height*self.sine), parent.height / (self.source-width*self.sine + self.source-height*self.cosine));
            width: self.source-width * self.fit-pixel * self.zoom-factor;
            height: self.source-height * self.fit-pixel * self.zoom-factor;
            x: (parent.width - self.width) / 2 + AppState.zoom-pan-x;
            y: (parent.height - self.height) / 2 + AppState.zoom-pan-y;
            image-fit: contain;

            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: AppState.rotation-angle * 1deg;
            transform-scale-x: AppState.mirror-horizontal ? -100% : 100%;
            transform-scale-y: AppState.mirror-vertical ? -100% : 100%;
        }

        pan-area := TouchArea {
            private property <length> pan-start-x;
            private property <length> pan-start-y;

            pointer-event(event) => {
                if event.kind == PointerEventKind.move {
                    AppState.show-viewport-controls();
                }
            }

            changed pressed => {
                if self.pressed {
                    live-pan-focus.focus();
                    self.pan-start-x = AppState.zoom-pan-x;
                    self.pan-start-y = AppState.zoom-pan-y;
                }
            }

            moved => {
                if self.pressed && AppState.is-streaming && AppState.zoom-level > 100 {
                    let limit-x = self.width * (AppState.zoom-level / 100.0 - 1) / 2;
                    let limit-y = self.height * (AppState.zoom-level / 100.0 - 1) / 2;
                    AppState.zoom-pan-x = clamp(self.pan-start-x + self.mouse-x - self.pressed-x, -limit-x, limit-x);
                    AppState.zoom-pan-y = clamp(self.pan-start-y + self.mouse-y - self.pressed-y, -limit-y, limit-y);
                }
            }

            scroll-event(event) => {
                if !AppState.is-streaming || event.delta-y == 0 { return reject; }
                AppState.zoom-level = Math.max(100, Math.min(200,
                AppState.zoom-level + (event.delta-y > 0 ? 10 : -10)));
                AppState.zoom-pan-x = 0px;
                AppState.zoom-pan-y = 0px;
                return accept;
            }
        }

        live-pan-focus := FocusScope {
            width: 0px;
            height: 0px;
            focus-on-tab-navigation: AppState.is-streaming && AppState.zoom-level > 100;
            KeyBinding { keys: @keys(Escape); activated => { AppState.dismiss-top-overlay(); } }
            key-pressed(event) => {
                if !AppState.is-streaming || AppState.zoom-level <= 100 { return reject; }
                if event.text == Key.LeftArrow {
                    AppState.zoom-pan-x = clamp(AppState.zoom-pan-x + 24px, -root.pan-limit-x, root.pan-limit-x);
                    return accept;
                }
                if event.text == Key.RightArrow {
                    AppState.zoom-pan-x = clamp(AppState.zoom-pan-x - 24px, -root.pan-limit-x, root.pan-limit-x);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    AppState.zoom-pan-y = clamp(AppState.zoom-pan-y + 24px, -root.pan-limit-y, root.pan-limit-y);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    AppState.zoom-pan-y = clamp(AppState.zoom-pan-y - 24px, -root.pan-limit-y, root.pan-limit-y);
                    return accept;
                }
                return reject;
            }
        }
        if live-pan-focus.has-focus: Rectangle {
            width: 100%;
            height: 100%;
            border-width: 2px;
            border-color: Design.overlay-accent;
            background: transparent;
        }

        fullscreen-exit := AppButton {
            width: self.preferred-width;
            x: parent.width - self.width - Design.inset;
            y: Design.inset;
            height: Design.control-height;
            overlay: true;
            visible: AppState.iris-fullscreen && (AppState.viewport-controls-visible || AppState.presentation-mode);
            text: AppState.presentation-mode ? "Fin présentation" : "Quitter le plein écran";
            tooltip: "Revenir à la vue caméra · Échap";
            clicked => {
                if AppState.presentation-mode { AppState.toggle-presentation(); return; }
                AppState.image-controls-open = false;
                AppState.iris-fullscreen = !AppState.iris-fullscreen;
                AppState.show-viewport-controls();
            }
        }

        if !AppState.sidebar-visible && !AppState.iris-fullscreen && !AppState.presentation-mode: AppButton {
            width: self.preferred-width;
            x: Design.inset;
            y: AppState.is-recording || AppState.session-photo-count > 0 || AppState.is-frozen ? Design.inset + Design.control-height + Design.gap-small : Design.inset;
            height: Design.control-height;
            text: "Afficher le panneau";
            overlay: true;
            compact: true;
            visible: !AppState.image-controls-open;
            accessibility-label: "Afficher le panneau patient et capture";
            clicked => { AppState.sidebar-visible = true; }
        }

        viewport-capture := AppButton {
            width: self.preferred-width;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - (AppState.iris-fullscreen ? Design.inset : 40px);
            height: Design.capture-height;
            visible: (AppState.iris-fullscreen || !AppState.sidebar-visible || AppState.presentation-mode)
                && (!AppState.iris-fullscreen || AppState.viewport-controls-visible || AppState.is-recording || AppState.recording-busy);
            text: AppState.capture-label;
            primary: !AppState.is-recording;
            danger: AppState.is-recording;
            overlay: true;
            enabled: self.visible && AppState.capture-enabled;
            clicked => { AppState.capture(); }
        }
        if AppState.iris-fullscreen && AppState.viewport-controls-visible && !AppState.capture-enabled: Rectangle {
            width: min(360px, parent.width - 32px);
            height: capture-reason.preferred-height + 16px;
            x: (parent.width - self.width) / 2;
            y: viewport-capture.y - self.height - 8px;
            background: Design.overlay-panel;
            border-radius: Design.control-radius;
            capture-reason := Text {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                text: AppState.capture-hint;
                color: Design.overlay-text;
                font-family: Design.font-ui;
                font-size: Design.control-font-size;
                font-weight: Design.control-font-weight;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
        if !AppState.sidebar-visible && !AppState.iris-fullscreen: Text {
            x: 16px;
            y: parent.height - 32px;
            width: parent.width - 32px;
            height: 20px;
            text: AppState.capture-hint;
            color: Design.overlay-text;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        if AppState.is-streaming && AppState.show-iridology-grid: Rectangle {
            width: max(0px, min(parent.width - 32px, parent.height - 32px, 480px));
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            border-width: 1.5px;
            border-color: #d8bb87bb;
        }

        if !AppState.is-streaming: VerticalLayout {
            padding: 24px;
            alignment: center;
            spacing: Design.gap;

            HorizontalLayout {
                height: 84px;
                alignment: center;
                Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: 36px;
                    border-width: 1px;
                    border-color: Design.border;
                    background: Design.surface-sunken;
                    Rectangle {
                        x: 17px;
                        y: 17px;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        border-width: 2px;
                        border-color: Design.accent;
                    }
                    Rectangle {
                        x: 31px;
                        y: 31px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: Design.accent;
                    }
                }
            }

            Text {
                text: "APERÇU CAMÉRA";
                color: Design.overlay-accent;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1.6px;
                horizontal-alignment: center;
                vertical-stretch: 0;
            }

            Text {
                text: AppState.camera-connected ? "Démarrage du flux en cours..." : "DE400 non détecté";
                color: Design.overlay-text;
                font-family: Design.font-ui;
                font-size: root.width < 600px ? 24px : 30px;
                horizontal-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
            Text {
                text: AppState.status-text;
                color: Design.overlay-text-muted;
                font-size: 13px;
                horizontal-alignment: center;
                wrap: word-wrap;
                vertical-stretch: 0;
            }
        }

        // Shutter flash effect
        Rectangle {
            width: 100%;
            height: 100%;
            background: Design.text;
            opacity: AppState.shutter-flash-opacity;
            animate opacity { duration: 180ms; easing: ease-out; }
        }

        if AppState.iris-fullscreen: OverlayBadge {
            x: Design.inset;
            y: Design.inset;
            width: min(self.preferred-width, parent.width - 2 * Design.inset - fullscreen-exit.width - Design.gap-small);
            text: (AppState.presentation-mode ? "Présentation" : AppState.patient-dossier-number == "" ? "Sans dossier patient" : "Dossier " + AppState.patient-dossier-number)
                    + " · " + (AppState.selected-eye == 1 ? "Œil gauche" : AppState.selected-eye == 2 ? "Œil droit" : "Œil à choisir")
                    + " · " + (AppState.is-video-mode ? "Vidéo" : "Photo");
        }

        if AppState.presentation-mode && !AppState.recording-busy: HorizontalLayout {
            x: Design.inset; y: Design.inset + Design.control-height + Design.gap-small;
            width: self.preferred-width; height: Design.control-height; spacing: 4px;
            if AppState.recording-busy: OverlayBadge {text:AppState.selected-eye == 1 ? "Œil gauche" : AppState.selected-eye == 2 ? "Œil droit" : "Œil à choisir";}
            if !AppState.recording-busy: HorizontalLayout { spacing: 4px;
            for eye in [{id:1,label:"Gauche"},{id:2,label:"Droit"}]: AppButton {
                compact: true; overlay: true; text: eye.label; checkable: true; selected: AppState.selected-eye == eye.id;
                enabled: !AppState.recording-busy;
                clicked => {AppState.selected-eye=eye.id; AppState.session-changed();}
            }
            }
        }

        recording-badge := OverlayBadge {
            visible: AppState.is-recording;
            x: Design.inset;
            y: AppState.iris-fullscreen ? Design.inset + Design.control-height + Design.gap-small : Design.inset;
            recording: true;
            text: "REC " + AppState.recording-duration;
        }

        OverlayBadge {
            visible: AppState.session-photo-count > 0 && !AppState.presentation-mode;
            x: AppState.is-recording ? recording-badge.x + recording-badge.width + Design.gap-small : Design.inset;
            y: recording-badge.y;
            text: AppState.session-photo-count + (AppState.session-photo-count > 1 ? " photos" : " photo");
        }

        OverlayBadge {
            visible: AppState.is-frozen;
            x: parent.width - self.width - Design.inset;
            y: recording-badge.y;
            text: "Image figée";
        }

        if AppState.image-controls-open: Rectangle {
            forward-focus: image-controls-close;
            init => { image-controls-close.focus(); }
            x: Design.inset;
            y: Design.inset + (AppState.is-recording || AppState.session-photo-count > 0 || AppState.is-frozen ? 1 : 0) * (Design.control-height + Design.gap-small)
                + (AppState.iris-fullscreen ? Design.control-height + Design.gap-small : 0px);
            width: min(360px, parent.width - 32px);
            height: min(parent.height - self.y - 16px, AppState.camera-controls.length == 0 ? 200px : 488px);
            border-radius: Design.card-radius;
            border-width: 1px;
            border-color: Design.border-strong;
            background: #202a26;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000055;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {}
                scroll-event(event) => { return accept; }
            }

            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    alignment: space-between;
                    Text {
                        text: "Réglages image";
                        color: Design.overlay-text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    image-controls-close := AppButton {
                        overlay: true;
                        compact: true;
                        height: 32px;
                        text: "Fermer";
                        clicked => { AppState.image-controls-open = false; }
                    }
                }
                Text {
                    height: 32px;
                    vertical-stretch: 0;
                    text: "Ajustements en direct, enregistrés automatiquement.";
                    color: Design.overlay-text-secondary;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 1px; vertical-stretch: 0; background: Design.overlay-border; }

                if AppState.camera-controls.length == 0: Text {
                    text: AppState.camera-connected
                    ? "Cette caméra ne propose aucun réglage d'image accessible."
                    : "Branchez l'iridoscope pour régler l'image.";
                    color: Design.overlay-text-secondary;
                    wrap: word-wrap;
                }

                if AppState.camera-controls.length > 0: controls-scroll := ScrollView {
                    min-height: 0px;
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: max(0px, controls-scroll.visible-width - Design.scroll-gutter);
                        spacing: 6px;
                        for control in AppState.camera-controls: Rectangle {
                            height: 80px;
                            border-radius: 6px;
                            background: Design.overlay-control;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 5px;
                                HorizontalLayout {
                                    height: 20px;
                                    vertical-stretch: 0;
                                    alignment: space-between;
                                    HelpText {
                                        height: 20px;
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        text: control.name;
                                        full-text: control.kind == 2 ? control.name + "\n" + control.menu-label : control.name;
                                        color: Design.overlay-text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    if control.read-only: Text {
                                        height: 20px;
                                        text: "Lecture seule";
                                        color: Design.overlay-text-secondary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                                if control.kind == 0: HorizontalLayout {
                                    height: 32px;
                                    vertical-stretch: 0;
                                    spacing: 6px;
                                    AppSlider {
                                        overlay: true;
                                        label: control.name;
                                        horizontal-stretch: 1;
                                        minimum: control.minimum;
                                        maximum: control.maximum;
                                        step: control.step;
                                        value: control.value;
                                        enabled: !control.read-only;
                                        changed => { AppState.set-camera-control-value(control.key, self.value); }
                                    }
                                    Text {
                                        width: 58px;
                                        overflow: elide;
                                        text: control.value-label;
                                        color: Design.overlay-text;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }
                                if control.kind == 3: HorizontalLayout {
                                    height: 32px;
                                    vertical-stretch: 0;
                                    spacing: 6px;
                                    AppButton {
                                        overlay: true;
                                        compact: true;
                                        height: 32px;
                                        text: "−";
                                        accessibility-label: "Diminuer " + control.name;
                                        enabled: !control.read-only;
                                        clicked => { AppState.step-camera-control(control.key, -1); }
                                    }
                                    Text {
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                        text: control.value-label;
                                        color: Design.overlay-text;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    AppButton {
                                        overlay: true;
                                        compact: true;
                                        height: 32px;
                                        text: "+";
                                        accessibility-label: "Augmenter " + control.name;
                                        enabled: !control.read-only;
                                        clicked => { AppState.step-camera-control(control.key, 1); }
                                    }
                                }
                                if control.kind == 1: AppButton {
                                    overlay: true;
                                    compact: true;
                                    height: 32px;
                                    vertical-stretch: 0;
                                    text: control.boolean-value ? "Activé" : "Désactivé";
                                    checkable: true;
                                    selected: control.boolean-value;
                                    accessibility-label: control.name;
                                    enabled: !control.read-only;
                                    clicked => { AppState.set-camera-control-bool(control.key, !control.boolean-value); }
                                }
                                if control.kind == 2: menu := AppComboBox {
                                    height: 32px;
                                    min-width: 0px;
                                    vertical-stretch: 0;
                                    model: control.menu-options;
                                    private property <int> native-index: control.menu-index;
                                    changed native-index => { self.current-index = self.native-index; }
                                    current-index: control.menu-index;
                                    enabled: !control.read-only && control.menu-options.length > 0;
                                    accessible-label: control.name;
                                    selected => { AppState.select-camera-control-menu(control.key, self.current-index); }
                                }
                            }
                        }
                    }
                }
                if AppState.camera-controls.length > 0: AppButton {
                    overlay: true;
                    compact: true;
                    height: 32px;
                    vertical-stretch: 0;
                    text: "Rétablir les valeurs d'origine";
                    enabled: AppState.camera-controls.length > 0;
                    clicked => { AppState.reset-camera-controls(); }
                }
            }
        }

    }

    if !AppState.iris-fullscreen: Rectangle {
        y: parent.height - root.tools-height;
        width: 100%;
        height: root.tools-height;
        background: Design.surface;
        Rectangle { y: 0px; width: 100%; height: 1px; background: Design.border; }
        GridLayout {
            padding: 8px;
            spacing: root.compact-tools ? 12px : 8px;
            // Independent rows avoid sharing the widest cell of each column.
            HorizontalLayout {
                row: 0; col: 0;
                min-width: 0px;
                height: Design.compact-control-height;
                spacing: 6px;
                AppButton {
                    height: 32px; compact: true;
                    text: AppState.is-frozen ? "Reprendre" : "Figer";
                    checkable: true;
                    selected: AppState.is-frozen;
                    enabled: AppState.is-streaming || AppState.is-frozen;
                    clicked => { AppState.toggle-freeze(); }
                }
                AppButton {
                    height: 32px; compact: true;
                    text: "Grille";
                    accessibility-label: "Afficher la grille de l'iris";
                    checkable: true;
                    selected: AppState.show-iridology-grid;
                    enabled: AppState.is-streaming;
                    clicked => { AppState.show-iridology-grid = !AppState.show-iridology-grid; }
                }
                ZoomControl {
                    horizontal-stretch: 1;
                    zoom <=> AppState.zoom-level;
                    enabled: AppState.is-streaming;
                    adjusted => { AppState.zoom-pan-x = 0px; AppState.zoom-pan-y = 0px; }
                }
            }
            HorizontalLayout {
                row: root.compact-tools ? 1 : 0;
                col: root.compact-tools ? 0 : 1;
                height: Design.compact-control-height;
                horizontal-stretch: 0;
                alignment: end;
                spacing: 6px;
                RotationControl {
                    short-label: true;
                    left-limit: root.absolute-position.x + 8px;
                    right-limit: root.absolute-position.x + root.width - 8px;
                    above-clearance: root.compact-tools ? 52px : 8px;
                    angle <=> AppState.rotation-angle;
                    enabled: AppState.is-streaming;
                    adjusted => { AppState.zoom-pan-x = 0px; AppState.zoom-pan-y = 0px; }
                }
                MirrorControl {
                    left-limit: root.absolute-position.x + 8px;
                    right-limit: root.absolute-position.x + root.width - 8px;
                    above-clearance: root.compact-tools ? 52px : 8px;
                    horizontal <=> AppState.mirror-horizontal;
                    vertical <=> AppState.mirror-vertical;
                    enabled: AppState.is-streaming;
                }
                AppButton {
                    height: 32px; compact: true;
                    text: "Réglages";
                    accessibility-label: "Réglages de l'image en direct";
                    checkable: true;
                    selected: AppState.image-controls-open;
                    clicked => { AppState.image-controls-open = !AppState.image-controls-open; }
                }
                AppButton {
                    height: 32px; compact: true; text: "Présenter";
                    tooltip: "Présenter l’iris en masquant les informations privées";
                    clicked => { AppState.image-controls-open = false; AppState.toggle-presentation(); }
                }
                AppButton {
                    height: 32px; compact: true;
                    text: "Plein écran";
                    tooltip: "Agrandir l’aperçu · Échap pour revenir";
                    clicked => { AppState.image-controls-open = false; AppState.iris-fullscreen = true; AppState.show-viewport-controls(); }
                }
            }
        }
    }
}
