import { AppButton, InputMode } from "./controls.slint";
import { Design } from "./theme.slint";
import { PopupBounds } from "./popup-bounds.slint";

export component MirrorControl inherits AppButton {
    in-out property <bool> horizontal: false;
    in-out property <bool> vertical: false;
    in property <length> left-limit: 8px;
    in property <length> right-limit: PopupBounds.width - 8px;
    in property <length> above-clearance: 0px;
    private property <length> menu-width: min(180px, root.right-limit - root.left-limit);
    out property <length> popup-left: clamp(root.absolute-position.x + (root.width - root.menu-width) / 2,
        root.left-limit, root.right-limit - root.menu-width);
    out property <length> popup-top: clamp(root.absolute-position.y - 88px - root.above-clearance,
        8px, PopupBounds.height - 92px);
    compact: true; text: "Miroir"; checkable: true;
    selected: root.horizontal || root.vertical;
    accessibility-label: "Choisir le miroir horizontal ou vertical";
    clicked => { mirror-menu.show(); }
    mirror-menu := PopupWindow {
        x: root.popup-left - root.absolute-position.x;
        y: root.popup-top - root.absolute-position.y;
        width: root.menu-width; height: 84px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            KeyBinding { keys: @keys(Escape); activated => { InputMode.keyboard-navigation = true; mirror-menu.close(); } }
        Rectangle {
            background: root.overlay ? Design.overlay-panel : Design.surface-raised;
            border-width: 1px; border-color: root.overlay ? Design.overlay-border : Design.border; border-radius: Design.control-radius;
            choices := VerticalLayout { padding: 8px; spacing: 4px;
                AppButton { height: 32px; compact: true; overlay: root.overlay; left-aligned: true; text: "Miroir horizontal"; checkable: true; selected: root.horizontal; enabled: root.enabled; clicked => {root.horizontal = !root.horizontal;} }
                AppButton { height: 32px; compact: true; overlay: root.overlay; left-aligned: true; text: "Miroir vertical"; checkable: true; selected: root.vertical; enabled: root.enabled; clicked => {root.vertical = !root.vertical;} }
            }
        }
        }
    }
}
