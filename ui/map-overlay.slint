import { AppButton, AppSlider } from "./controls.slint";
import { AppState } from "./state.slint";
import { Design } from "./theme.slint";

export component MapOverlay inherits Rectangle {
    accessible-role: groupbox;
    accessible-label: "Images de référence";
    forward-focus: map-close-button;
    init => { map-close-button.focus(); }
    private property <bool> reference-loaded: AppState.iridology-reference-mode == 0
        ? AppState.has-iridology-map : AppState.has-iridology-symbols;
    private property <length> pan-limit-x: max(0px,
        reference-area.width * (AppState.iridology-reference-zoom - 100) / 200);
    private property <length> pan-limit-y: max(0px,
        reference-area.height * (AppState.iridology-reference-zoom - 100) / 200);
    changed pan-limit-x => {
        AppState.iridology-reference-pan-x = clamp(AppState.iridology-reference-pan-x,
            -root.pan-limit-x, root.pan-limit-x);
    }
    changed pan-limit-y => {
        AppState.iridology-reference-pan-y = clamp(AppState.iridology-reference-pan-y,
            -root.pan-limit-y, root.pan-limit-y);
    }

    function reset-view() {
        AppState.iridology-reference-zoom = 100;
        AppState.iridology-reference-pan-x = 0px;
        AppState.iridology-reference-pan-y = 0px;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Design.overlay-surface;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {}

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    height: 52px;
                    vertical-stretch: 0;
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        vertical-stretch: 0;
                        Text {
                            text: "Images de référence";
                            color: Design.overlay-text;
                            font-family: Design.font-ui;
                            font-size: 24px;
                            font-weight: 600;
                            vertical-stretch: 0;
                        }
                        Text {
                            text: "Carte d’iridologie et planche de signes";
                            color: Design.overlay-text-muted;
                            font-size: 12px;
                            vertical-stretch: 0;
                        }
                    }
                    map-close-button := AppButton {
                        height: 40px;
                        text: "Fermer";
                        accessibility-label: "Fermer les images de référence";
                        overlay: true;
                        clicked => { AppState.library-map-open = false; }
                    }
                }

                if AppState.has-iridology-map || AppState.has-iridology-symbols: Rectangle {
                    height: root.width < 900px ? 112px : 60px;
                    vertical-stretch: 0;
                    border-radius: Design.card-radius;
                    background: Design.overlay-panel;
                    border-width: 1px;
                    border-color: Design.overlay-border;
                    GridLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            row: 0;
                            col: 0;
                            alignment: start;
                            spacing: 8px;
                            height: 40px;
                            vertical-stretch: 0;
                            AppButton {
                                height: 40px;
                                text: "Carte";
                                overlay: true;
                                checkable: true;
                                selected: AppState.iridology-reference-mode == 0;
                                clicked => {
                                    AppState.iridology-reference-mode = 0;
                                    root.reset-view();
                                }
                            }
                            if AppState.settings-iridology-symbols-path != "": AppButton {
                                height: 40px;
                                text: "Signes et symboles";
                                overlay: true;
                                checkable: true;
                                selected: AppState.iridology-reference-mode == 1;
                                clicked => {
                                    AppState.iridology-reference-mode = 1;
                                    root.reset-view();
                                }
                            }
                        }
                        HorizontalLayout {
                            row: root.width < 900px ? 1 : 0;
                            col: root.width < 900px ? 0 : 1;
                            alignment: end;
                            height: 40px;
                            vertical-stretch: 0;
                            spacing: 8px;
                            Text {
                                text: "Zoom";
                                color: Design.overlay-text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            AppSlider {
                                label: "Zoom de l’image de référence";
                                overlay: true;
                                width: root.width < 900px ? 180px : 140px;
                                height: 32px;
                                minimum: 100;
                                maximum: 200;
                                value: AppState.iridology-reference-zoom;
                                enabled: root.reference-loaded;
                                changed => {
                                    AppState.iridology-reference-zoom = round(self.value);
                                    AppState.iridology-reference-pan-x = 0px;
                                    AppState.iridology-reference-pan-y = 0px;
                                }
                            }
                            Text {
                                width: 48px;
                                text: AppState.iridology-reference-zoom + " %";
                                color: Design.overlay-text;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            AppButton {
                                text: "Ajuster";
                                accessibility-label: "Ajuster l’image de référence à la fenêtre";
                                compact: true;
                                overlay: true;
                                enabled: root.reference-loaded && AppState.iridology-reference-zoom != 100;
                                clicked => { root.reset-view(); }
                            }
                        }
                    }
                }

                reference-area := Rectangle {
                    min-height: 0px;
                    min-width: 0px;
                    vertical-stretch: 1;
                    accessible-role: groupbox;
                    accessible-label: "Image de référence. Utilisez les flèches pour déplacer la vue agrandie.";
                    forward-focus: reference-pan-focus;
                    background: #080d0b;
                    border-radius: Design.card-radius;
                    border-width: 1px;
                    border-color: Design.overlay-border;
                    clip: true;

                    if AppState.iridology-reference-mode == 0 && AppState.has-iridology-map: Image {
                        source: AppState.iridology-map-image;
                        width: parent.width * AppState.iridology-reference-zoom / 100.0;
                        height: parent.height * AppState.iridology-reference-zoom / 100.0;
                        x: (parent.width - self.width) / 2 + AppState.iridology-reference-pan-x;
                        y: (parent.height - self.height) / 2 + AppState.iridology-reference-pan-y;
                        image-fit: contain;
                    }

                    if AppState.iridology-reference-mode == 1 && AppState.has-iridology-symbols: Image {
                        source: AppState.iridology-symbols-image;
                        width: parent.width * AppState.iridology-reference-zoom / 100.0;
                        height: parent.height * AppState.iridology-reference-zoom / 100.0;
                        x: (parent.width - self.width) / 2 + AppState.iridology-reference-pan-x;
                        y: (parent.height - self.height) / 2 + AppState.iridology-reference-pan-y;
                        image-fit: contain;
                    }

                    if !root.reference-loaded: VerticalLayout {
                        padding: 24px;
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: AppState.iridology-reference-mode == 0
                                ? "Ajoutez votre carte d’iridologie"
                                : "Ajoutez votre planche de signes";
                            color: Design.overlay-text;
                            font-size: 18px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                        Text {
                            text: "Choisissez une image JPEG ou PNG dans les paramètres pour la consulter ici.";
                            color: Design.overlay-text-muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                        HorizontalLayout {
                            alignment: center;
                            vertical-stretch: 0;
                            AppButton {
                                text: "Ouvrir les paramètres";
                                height: 40px;
                                primary: true;
                                overlay: true;
                                clicked => {
                                    AppState.library-map-open = false;
                                    AppState.navigate-to(4);
                                }
                            }
                        }
                    }

                    TouchArea {
                        enabled: AppState.iridology-reference-zoom > 100 && root.reference-loaded;
                        private property <length> pan-start-x;
                        private property <length> pan-start-y;
                        changed pressed => {
                            if self.pressed {
                                reference-pan-focus.focus();
                                self.pan-start-x = AppState.iridology-reference-pan-x;
                                self.pan-start-y = AppState.iridology-reference-pan-y;
                            }
                        }
                        moved => {
                            if self.pressed {
                                AppState.iridology-reference-pan-x = clamp(
                                    self.pan-start-x + self.mouse-x - self.pressed-x,
                                    -root.pan-limit-x, root.pan-limit-x);
                                AppState.iridology-reference-pan-y = clamp(
                                    self.pan-start-y + self.mouse-y - self.pressed-y,
                                    -root.pan-limit-y, root.pan-limit-y);
                            }
                        }
                    }

                    reference-pan-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        enabled: root.reference-loaded && AppState.iridology-reference-zoom > 100;
                        KeyBinding { keys: @keys(Escape); activated => { AppState.dismiss-top-overlay(); } }
                        key-pressed(event) => {
                            if event.text == Key.LeftArrow {
                                AppState.iridology-reference-pan-x = clamp(
                                    AppState.iridology-reference-pan-x + 24px,
                                    -root.pan-limit-x, root.pan-limit-x);
                                return accept;
                            }
                            if event.text == Key.RightArrow {
                                AppState.iridology-reference-pan-x = clamp(
                                    AppState.iridology-reference-pan-x - 24px,
                                    -root.pan-limit-x, root.pan-limit-x);
                                return accept;
                            }
                            if event.text == Key.UpArrow {
                                AppState.iridology-reference-pan-y = clamp(
                                    AppState.iridology-reference-pan-y + 24px,
                                    -root.pan-limit-y, root.pan-limit-y);
                                return accept;
                            }
                            if event.text == Key.DownArrow {
                                AppState.iridology-reference-pan-y = clamp(
                                    AppState.iridology-reference-pan-y - 24px,
                                    -root.pan-limit-y, root.pan-limit-y);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    if reference-pan-focus.has-focus: Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: Design.card-radius;
                        border-width: 2px;
                        border-color: Design.overlay-text;
                        background: transparent;
                    }
                }

                if root.reference-loaded: Text {
                    text: AppState.iridology-reference-zoom > 100
                        ? "Déplacez la vue en glissant l’image ou avec les flèches du clavier. Ajuster rétablit l’image complète."
                        : "Augmentez le zoom pour explorer les détails de votre référence.";
                    color: Design.overlay-text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
            }
        }
    }
}
