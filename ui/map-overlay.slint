import { ReferencePane } from "./reference-pane.slint";
import { ZoomControl } from "./zoom-control.slint";
import { AppButton } from "./controls.slint";
import { AppState } from "./state.slint";
import { Design } from "./theme.slint";

export component MapOverlay inherits Rectangle {
    accessible-role: groupbox;
    accessible-label: "Images de référence";
    forward-focus: map-close-button;
    init => { map-close-button.focus(); }
    private property <bool> reference-loaded: AppState.iridology-reference-mode == 0
        ? AppState.has-iridology-map : AppState.has-iridology-symbols;
    function reset-view() {
        AppState.iridology-reference-zoom = 100;
        AppState.iridology-reference-pan-x = 0px;
        AppState.iridology-reference-pan-y = 0px;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: Design.overlay-surface;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {}

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    height: 52px;
                    vertical-stretch: 0;
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        vertical-stretch: 0;
                        Text {
                            text: "Images de référence";
                            color: Design.overlay-text;
                            font-family: Design.font-ui;
                            font-size: 24px;
                            font-weight: 600;
                            vertical-stretch: 0;
                        }
                        Text {
                            text: "Carte d’iridologie et planche de signes";
                            color: Design.overlay-text-muted;
                            font-size: 12px;
                            vertical-stretch: 0;
                        }
                    }
                    map-close-button := AppButton {
                        height: 40px;
                        text: "Fermer";
                        accessibility-label: "Fermer les images de référence";
                        overlay: true;
                        clicked => { AppState.library-map-open = false; }
                    }
                }

                if AppState.has-iridology-map || AppState.has-iridology-symbols: Rectangle {
                    height: root.width < 900px ? 112px : 60px;
                    vertical-stretch: 0;
                    border-radius: Design.card-radius;
                    background: Design.overlay-panel;
                    border-width: 1px;
                    border-color: Design.overlay-border;
                    GridLayout {
                        padding: 10px;
                        spacing: 8px;
                        HorizontalLayout {
                            row: 0;
                            col: 0;
                            alignment: start;
                            spacing: 8px;
                            height: 40px;
                            vertical-stretch: 0;
                            AppButton {
                                height: 40px;
                                text: "Carte";
                                overlay: true;
                                checkable: true;
                                selected: AppState.iridology-reference-mode == 0;
                                clicked => {
                                    AppState.iridology-reference-mode = 0;
                                    root.reset-view();
                                }
                            }
                            if AppState.settings-iridology-symbols-path != "": AppButton {
                                height: 40px;
                                text: "Signes et symboles";
                                overlay: true;
                                checkable: true;
                                selected: AppState.iridology-reference-mode == 1;
                                clicked => {
                                    AppState.iridology-reference-mode = 1;
                                    root.reset-view();
                                }
                            }
                        }
                        HorizontalLayout {
                            row: root.width < 900px ? 1 : 0;
                            col: root.width < 900px ? 0 : 1;
                            alignment: end;
                            height: 40px;
                            vertical-stretch: 0;
                            spacing: 8px;
                            Text {
                                text: "Zoom";
                                color: Design.overlay-text-secondary;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                width: root.width < 900px ? 310px : 270px;
                                height: 40px;
                                background: transparent;
                                ZoomControl {
                                    y: (parent.height - self.height) / 2;
                                    width: 100%;
                                    label: "Zoom de l’image de référence";
                                    overlay: true;
                                    maximum: 400;
                                    zoom <=> AppState.iridology-reference-zoom;
                                    enabled: root.reference-loaded;
                                    adjusted => { AppState.iridology-reference-pan-x = 0px; AppState.iridology-reference-pan-y = 0px; }
                                }
                            }
                        }
                    }
                }

                reference-area := Rectangle {
                    min-height: 0px;
                    min-width: 0px;
                    vertical-stretch: 1;
                    accessible-role: groupbox;
                    accessible-label: "Image de référence. Utilisez les flèches pour déplacer la vue agrandie.";
                    background: root.reference-loaded ? Design.preview : Design.surface-sunken;
                    border-radius: Design.card-radius;
                    border-width: 1px;
                    border-color: Design.overlay-border;
                    clip: true;

                    ReferencePane {
                        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                        source: AppState.iridology-reference-mode == 0 ? AppState.iridology-map-image : AppState.iridology-symbols-image;
                        loaded: root.reference-loaded;
                        zoom <=> AppState.iridology-reference-zoom;
                        pan-x <=> AppState.iridology-reference-pan-x;
                        pan-y <=> AppState.iridology-reference-pan-y;
                    }

                    if !root.reference-loaded: VerticalLayout {
                        padding: 24px;
                        alignment: center;
                        spacing: 12px;
                        Text {
                            text: AppState.iridology-reference-mode == 0
                                ? "Ajoutez votre carte d’iridologie"
                                : "Ajoutez votre planche de signes";
                            color: Design.overlay-text;
                            font-size: 18px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                        Text {
                            text: "Choisissez une image JPEG ou PNG dans les paramètres pour la consulter ici.";
                            color: Design.overlay-text-muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                        HorizontalLayout {
                            alignment: center;
                            vertical-stretch: 0;
                            AppButton {
                                text: "Ouvrir les paramètres";
                                height: 40px;
                                primary: true;
                                overlay: true;
                                clicked => {
                                    AppState.library-map-open = false;
                                    AppState.navigate-to(4);
                                }
                            }
                        }
                    }


                }

                if root.reference-loaded: Text {
                    text: AppState.iridology-reference-zoom > 100
                        ? "Déplacez la vue en glissant l’image ou avec les flèches du clavier. Ajuster rétablit l’image complète."
                        : "Utilisez la molette ou le curseur pour explorer les détails de votre référence.";
                    color: Design.overlay-text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
            }
        }
    }
}
