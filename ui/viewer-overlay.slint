import { ActionMenu, MenuAction } from "./action-menu.slint";
import { ResizeHandle } from "./resize-handle.slint";
import { AppButton, AppSlider, Tooltip } from "./controls.slint";
import { AppState } from "./state.slint";
import { Design } from "./theme.slint";
import { PhotoPane } from "./photo-pane.slint";
import { ViewerTools } from "./viewer-tools.slint";

export component ViewerOverlay inherits Rectangle {
    accessible-role: groupbox; accessible-label: "Visionneuse de capture";
    forward-focus: close-button;
    init => { if AppState.image-only && !AppState.viewer-is-video { AppState.focus-main-controls(); } else { close-button.focus(); } }
    background: Design.overlay-surface;
    TouchArea { clicked => {} }
    private property <bool> controls-shown: AppState.viewer-is-video || !AppState.image-only || AppState.photo-controls-visible;
    private property <float> zoom-value: AppState.viewer-fit ? current-pane.actual-zoom : AppState.viewer-zoom;
    changed zoom-value => { zoom-slider.value = root.zoom-value; }
    private property <length> panel-width: clamp(AppState.viewer-panel-width == 0 ? (root.width < 1000px ? 252px : 300px) : AppState.viewer-panel-width * 1px,252px,max(252px,min(480px,root.width - 500px)));
    private property <bool> toolbar-interacting: tools-menu.interacting || view-menu.interacting || export-button.active-interaction || close-button.active-interaction || fit-button.active-interaction || zoom-out-button.active-interaction || zoom-in-button.active-interaction || zoom-slider.active-interaction || previous-button.active-interaction || next-button.active-interaction;
    changed toolbar-interacting => { AppState.photo-controls-interacting = root.toolbar-interacting; if root.toolbar-interacting { AppState.show-photo-controls(); } }
    private property <int> review-revision: AppState.viewer-review-revision;
    changed review-revision => { if AppState.viewer-review-dirty && !AppState.viewer-review-busy { autosave.restart(); } }
    autosave := Timer { interval: 700ms; running: AppState.viewer-review-dirty && !AppState.viewer-review-busy && !AppState.viewer-review-load-error && !AppState.viewer-autosave-paused; triggered => { AppState.save-viewer-review(); } }
    VerticalLayout {
        padding: root.width < 900px ? 12px : 20px; spacing: 10px;
        Rectangle {
            height: root.controls-shown ? 78px : 0px; vertical-stretch: 0; clip: true;
            visible: root.controls-shown;
            VerticalLayout { width: 100%; height: 78px; spacing: 10px;
                HorizontalLayout {
                    height: 36px; vertical-stretch: 0; spacing: 8px;
                    Text { min-width: 0px; horizontal-stretch: 1; text: AppState.viewer-loading ? "Ouverture…" : AppState.viewer-is-video ? "Vidéo de l’iris" : "Photo de l’iris"; color: Design.overlay-text; font-size: 22px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                    tools-menu := ActionMenu {
                        collapse-when-hidden: true; visible: !AppState.viewer-is-video;
                        compact: true; overlay: true; text: "Outils ▾"; enabled: !AppState.viewer-loading;
                        private property <[MenuAction]> presentation-actions: [
                            {id: 2, label: "Références visuelles", enabled: true, checked: AppState.viewer-panel == 2 && !AppState.image-only},
                            {id: 3, label: "Réglages d’affichage", enabled: true, checked: AppState.viewer-panel == 3 && !AppState.image-only},
                        ];
                        private property <[MenuAction]> standard-actions: [
                            {id: 1, label: "Annoter et noter", enabled: true, checked: AppState.viewer-panel == 1 && !AppState.image-only},
                            {id: 4, label: "Comparer les prises", enabled: true, checked: AppState.viewer-panel == 4 && !AppState.image-only},
                            {id: 2, label: "Références visuelles", enabled: true, checked: AppState.viewer-panel == 2 && !AppState.image-only},
                            {id: 3, label: "Réglages d’affichage", enabled: true, checked: AppState.viewer-panel == 3 && !AppState.image-only},
                            {id: 6, label: AppState.viewer-retained ? "Photo retenue" : "Retenir cette photo", enabled: !AppState.viewer-review-load-error, checked: AppState.viewer-retained},
                        ];
                        actions: AppState.presentation-mode ? self.presentation-actions : self.standard-actions;
                        chosen(id) => {
                            if id == 6 { AppState.viewer-retained = !AppState.viewer-retained; AppState.viewer-review-edited(); }
                            else { AppState.select-photo-panel(AppState.viewer-panel == id && !AppState.image-only ? 0 : id); }
                        }
                    }
                    view-menu := ActionMenu {
                        compact: true; overlay: true; text: "Vue ▾";
                        private property <[MenuAction]> video-actions: [
                            {id: 4, label: AppState.viewer-fullscreen ? "Quitter le plein écran" : "Plein écran", enabled: true, checked: AppState.viewer-fullscreen},
                            {id: 5, label: AppState.presentation-mode ? "Quitter le mode patient" : "Présenter au patient", enabled: true, checked: AppState.presentation-mode},
                        ];
                        private property <[MenuAction]> photo-actions: [
                            {id: 1, label: AppState.image-only ? "Vue complète" : "Image seule", enabled: true, checked: AppState.image-only},
                            {id: 2, label: "Taille réelle · 100 %", enabled: !AppState.viewer-loading, checked: !AppState.viewer-fit && AppState.viewer-zoom == 100},
                            {id: 3, label: "Loupe", enabled: !AppState.viewer-loading, checked: AppState.viewer-loupe},
                            {id: 4, label: AppState.viewer-fullscreen ? "Quitter le plein écran" : "Plein écran", enabled: true, checked: AppState.viewer-fullscreen},
                            {id: 5, label: AppState.presentation-mode ? "Quitter le mode patient" : "Présenter au patient", enabled: true, checked: AppState.presentation-mode},
                        ];
                        actions: AppState.viewer-is-video ? self.video-actions : self.photo-actions;
                        chosen(id) => {
                            if id == 1 { AppState.toggle-image-only(); }
                            else if id == 2 { AppState.viewer-fit = false; AppState.viewer-zoom = 100; AppState.viewer-pan-x = 0px; AppState.viewer-pan-y = 0px; AppState.link-view(false); }
                            else if id == 3 { AppState.viewer-loupe = !AppState.viewer-loupe; }
                            else if id == 4 { AppState.viewer-fullscreen = !AppState.viewer-fullscreen; }
                            else { AppState.toggle-presentation(); }
                        }
                    }
                    export-button := AppButton {
                        collapse-when-hidden: true; visible: !AppState.presentation-mode;
                        compact: true; overlay: true; text: "Exporter…";
                        enabled: !AppState.viewer-loading && (!AppState.viewer-is-video || (!AppState.export-busy && !AppState.storage-busy && !AppState.file-dialog-pending));
                        checkable: !AppState.viewer-is-video; selected: !AppState.viewer-is-video && AppState.viewer-panel == 5 && !AppState.image-only;
                        clicked => { if AppState.viewer-is-video { AppState.export-viewer-mp4(); } else { AppState.select-photo-panel(AppState.viewer-panel == 5 && !AppState.image-only ? 0 : 5); } }
                    }
                    close-button := AppButton { compact: true; overlay: true; text: "Fermer"; accessibility-label: "Fermer la visionneuse, touche Échap"; clicked => { AppState.dismiss-viewer(); } }
                }
                HorizontalLayout {
                    height: 32px; vertical-stretch: 0; spacing: 6px;
                    previous-button := AppButton { compact: true; overlay: true; text: "‹"; width: 32px; accessibility-label: "Capture précédente"; tooltip: "Prise précédente"; enabled: !AppState.viewer-loading && !AppState.library-loading && !AppState.viewer-review-busy; clicked => { AppState.navigate-viewer(-1); } }
                    next-button := AppButton { compact: true; overlay: true; text: "›"; width: 32px; accessibility-label: "Capture suivante"; tooltip: "Prise suivante"; enabled: !AppState.viewer-loading && !AppState.library-loading && !AppState.viewer-review-busy; clicked => { AppState.navigate-viewer(1); } }
                    fit-button := AppButton { compact: true; overlay: true; text: "Ajuster"; checkable: true; selected: AppState.viewer-fit; enabled: !AppState.viewer-loading; clicked => { AppState.fit-viewer(); } }
                    zoom-out-button := AppButton { compact: true; overlay: true; text: "−"; accessibility-label: "Réduire le zoom"; enabled: !AppState.viewer-loading; clicked => { current-pane.zoom-at(round((AppState.viewer-fit ? current-pane.actual-zoom : AppState.viewer-zoom)/1.2),current-pane.width/2,current-pane.height/2); } }
                    zoom-slider := AppSlider { overlay: true; label: "Zoom de la photo en pourcentage de pixels"; minimum: 10; maximum: 800; step: 1; value: AppState.viewer-fit ? current-pane.actual-zoom : AppState.viewer-zoom; enabled: !AppState.viewer-loading; changed => { current-pane.zoom-at(round(self.value), current-pane.width/2, current-pane.height/2); } }
                    Text { width: 56px; text: AppState.viewer-fit ? "Ajusté" : AppState.viewer-zoom + " %"; color: Design.overlay-text-secondary; font-size: 12px; vertical-alignment: center; horizontal-alignment: center; }
                    zoom-in-button := AppButton { compact: true; overlay: true; text: "+"; accessibility-label: "Augmenter le zoom"; enabled: !AppState.viewer-loading; clicked => { current-pane.zoom-at(round((AppState.viewer-fit ? current-pane.actual-zoom : AppState.viewer-zoom)*1.2),current-pane.width/2,current-pane.height/2); } }
                }
            }
        }
        // A fixed status row prevents autosave transitions from moving the photo.
        review-feedback := Text {
            height: !AppState.viewer-is-video && root.controls-shown ? 24px : 0px;
            vertical-stretch: 0;
            text: AppState.presentation-mode
                ? (AppState.viewer-feedback-error || AppState.viewer-autosave-paused || AppState.viewer-review-load-error ? "Une erreur est survenue. Quittez la présentation pour consulter les détails." : AppState.viewer-review-status)
                : AppState.viewer-feedback-error ? AppState.viewer-feedback : AppState.viewer-review-dirty || AppState.viewer-review-busy || AppState.viewer-feedback == "" ? AppState.viewer-review-status : AppState.viewer-feedback;
            color: AppState.viewer-feedback-error || AppState.viewer-autosave-paused || AppState.viewer-review-load-error ? Design.overlay-danger : Design.overlay-text-secondary;
            font-size: 12px; overflow: elide; vertical-alignment: center;
            accessible-label: self.text;
            status-hover := TouchArea { }
            Tooltip { text: review-feedback.text; active: status-hover.has-hover; }
        }
        if AppState.export-feedback != "": HorizontalLayout {
            spacing: 8px; vertical-stretch: 0;
            Text { min-width: 0px; horizontal-stretch: 1; text: AppState.presentation-mode ? (AppState.export-feedback-error ? "Échec de l’export. Quittez la présentation pour consulter les détails." : AppState.export-busy ? "Export en cours…" : "Export terminé") : AppState.export-feedback; color: AppState.export-feedback-error ? Design.overlay-danger : Design.overlay-text-secondary; font-size: 12px; wrap: word-wrap; }
            if AppState.export-busy && !AppState.file-dialog-pending: AppButton { compact: true; overlay: true; text: "Annuler"; clicked => { AppState.cancel-video-export(); } }
        }
        if AppState.export-busy && AppState.export-progress-known: Rectangle {
            height: 6px; vertical-stretch: 0; border-radius: 3px; background: Design.overlay-control;
            accessible-role: progress-indicator; accessible-label: "Progression de l’export";
            accessible-value: AppState.export-progress; accessible-value-minimum: 0; accessible-value-maximum: 100;
            Rectangle { width: parent.width*AppState.export-progress/100; height: 100%; border-radius: 3px; background: Design.overlay-accent; }
        }
        HorizontalLayout {
            spacing: 10px; min-height: 0px; vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px; min-height: 0px; min-width: 0px; horizontal-stretch: 1;
                HorizontalLayout {
                    height: 32px; vertical-stretch: 0; spacing: 10px;
                    if AppState.comparison-enabled: Text { min-width: 0px; horizontal-stretch: 1; text: "Référence · " + (AppState.presentation-mode ? "Iris de référence" : AppState.comparison-caption) + (AppState.comparison-fit ? " · Ajustée" : " · " + AppState.comparison-zoom + " %"); color: Design.overlay-text-secondary; font-size: 11px; overflow: elide; wrap: word-wrap; }
                    Text { min-width: 0px; horizontal-stretch: 1; text: (AppState.presentation-mode ? (AppState.viewer-eye-label == "" ? "Iris observé" : AppState.viewer-eye-label) : AppState.viewer-caption) + (!AppState.viewer-show-original && (AppState.viewer-brightness != 0 || AppState.viewer-contrast != 0 || AppState.viewer-rotation != 0 || AppState.viewer-mirror) ? " · Affichage modifié" : ""); color: Design.overlay-text-secondary; font-size: 11px; overflow: elide; wrap: word-wrap; }
                }
                HorizontalLayout {
                    min-height: 0px; spacing: AppState.comparison-enabled ? 10px : 0px;
                    if AppState.comparison-enabled: PhotoPane {
                        photo: AppState.comparison-image; reference: true; horizontal-stretch: 1; min-width: 0px;
                        fit <=> AppState.comparison-fit; zoom <=> AppState.comparison-zoom;
                        pan-x <=> AppState.comparison-pan-x; pan-y <=> AppState.comparison-pan-y;
                        interactive: !AppState.comparison-loading;
                    }
                    current-pane := PhotoPane {
                        photo: AppState.viewer-image; min-width: 0px; min-height: 0px; horizontal-stretch: 1;
                        fit <=> AppState.viewer-fit; zoom <=> AppState.viewer-zoom;
                        pan-x <=> AppState.viewer-pan-x; pan-y <=> AppState.viewer-pan-y;
                        interactive: !AppState.viewer-loading && !AppState.viewer-review-busy && !AppState.viewer-adjusting;
                    }
                }
                if AppState.viewer-loading: Text { text: "Chargement…"; color: Design.overlay-text-secondary; horizontal-alignment: center; }
                if !AppState.viewer-is-video: Text { text: AppState.viewer-adjusting ? "Application des réglages…" : AppState.viewer-tool == 5 ? "Cliquez sur le centre de la pupille." : "Molette : zoom · glisser : déplacer · double-clic : ajuster · Échap : " + (AppState.image-only ? "vue complète" : AppState.viewer-fullscreen ? "quitter le plein écran" : "fermer"); color: Design.overlay-text-secondary; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
            }
            if AppState.viewer-panel != 0 && !AppState.viewer-is-video && !AppState.viewer-loading && !AppState.image-only && (!AppState.presentation-mode || AppState.viewer-panel == 2 || AppState.viewer-panel == 3): ResizeHandle {
                reverse: true; panel-width: root.panel-width; minimum: 252px; maximum: max(252px,min(480px,root.width - 500px)); overlay: true;
                label: "Largeur du panneau photo · flèches pour ajuster · double-clic pour rétablir";
                resized(value) => {AppState.viewer-panel-width=round(value/1px);}
                committed => {AppState.interface-edited();}
            }
            if AppState.viewer-panel != 0 && !AppState.viewer-is-video && !AppState.viewer-loading && !AppState.image-only && (!AppState.presentation-mode || AppState.viewer-panel == 2 || AppState.viewer-panel == 3): ViewerTools { width: root.panel-width; horizontal-stretch: 0; min-height: 0px; }
        }
        if AppState.viewer-is-video: HorizontalLayout {
            height: 36px; spacing: 10px; vertical-stretch: 0;
            AppButton { compact: true; overlay: true; text: AppState.viewer-video-playing ? "Pause" : "Lire"; enabled: !AppState.viewer-loading; clicked => { AppState.toggle-viewer-video(); } }
            Text { width: 48px; text: AppState.viewer-video-position; color: Design.overlay-text-secondary; vertical-alignment: center; }
            AppSlider { overlay: true; label: "Position dans la vidéo"; minimum: 0; maximum: 1000; value: AppState.viewer-video-progress; released(v) => { AppState.seek-viewer-video(v); } }
            Text { width: 48px; text: AppState.viewer-video-duration; color: Design.overlay-text-secondary; vertical-alignment: center; }
        }
    }
    if AppState.image-only && !AppState.viewer-is-video && !AppState.photo-controls-visible: AppButton {
        width: self.preferred-width; x: parent.width - self.width - 12px; y: 12px; height: 32px; compact: true; overlay: true;
        text: "Commandes"; tooltip: "Afficher les commandes · Échap : vue complète";
        clicked => { AppState.show-photo-controls(); }
    }
}
