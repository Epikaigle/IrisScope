import { ThumbnailSizeControl } from "./thumbnail-size.slint";
import { AppComboBox } from "./combo-box.slint";
import { DateField } from "./date-field.slint";
import { AppButton, Tooltip } from "./controls.slint";
import { Design } from "./theme.slint";
import { ScrollView, ListView, LineEdit } from "std-widgets.slint";
import { AppState } from "./state.slint";

export component LibraryPage inherits Rectangle {
    private property <length> content-inset: root.width < 900px ? 16px : 24px;
    private property <length> card-width: min(AppState.effective-thumbnail-width * 1px + 28px, root.width - 2 * root.content-inset - 16px);
    private property <int> library-grid-columns: clamp(floor((root.width - 2 * root.content-inset - 4px) / (root.card-width + 12px)), 1, 32);
    private property <length> thumbnail-height: round((root.card-width - 28px) / 1px * 0.75) * 1px;
    private property <length> list-image-width: clamp(AppState.effective-thumbnail-width * 0.4px, 48px, 192px);
    private property <length> list-image-height: round(root.list-image-width / 1px * 0.75) * 1px;
    private property <length> list-row-height: max(80px, root.list-image-height + 28px);
    private property <string> confirmation-patient-id: "";
    private property <string> confirmation-capture-path: "";
    private property <string> confirmation-file-version: "";
    private property <string> observed-patient-id: AppState.patient-id;
    private property <bool> confirming-assignment: root.confirmation-patient-id != ""
        && root.confirmation-patient-id == AppState.patient-id
        && root.confirmation-capture-path == AppState.selected-library-path
        && root.confirmation-file-version == AppState.selected-library-file-version;
    changed observed-patient-id => { root.confirmation-patient-id = ""; }

    public function select-capture(path: string, dossier-number: string, file-version: string) {
        AppState.selected-library-path = path;
        AppState.selected-library-file-version = file-version;
        AppState.selected-library-dossier-number = dossier-number;
        root.confirmation-patient-id = "";
    }
    VerticalLayout {
        padding: root.content-inset;
        spacing: 12px;

        HorizontalLayout {
            height: 56px;
            vertical-stretch: 0;
            alignment: space-between;
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Bibliothèque";
                    font-family: Design.font-ui;
                    font-size: 24px;
                    font-weight: 600;
                    color: Design.text;
                }
                Text {
                    text: AppState.library-error != ""
                    ? "Dossier des captures inaccessible"
                    : AppState.library-loading
                    ? "Chargement des captures…"
                    : AppState.library-total-count == 1
                    ? "1 capture"
                    : AppState.library-total-count + " captures";
                    font-size: 12px;
                    color: Design.text-muted;
                }
            }
            HorizontalLayout {
                height: 32px;
                vertical-stretch: 0;
                spacing: 8px;
                AppButton { height: 32px; compact: true; text: "Dossiers / Séances"; clicked => { AppState.open-consultation(); } }
                AppButton {
                    height: 32px;
                    compact: true;
                    quiet: true;
                    text: "Références";
                    accessibility-label: "Ouvrir les cartes d'iridologie";
                    clicked => { AppState.iridology-reference-mode = 0; AppState.library-map-open = true; }
                }
                AppButton {
                    height: 32px;
                    compact: true;
                    quiet: true;
                    enabled: !AppState.library-loading;
                    text: "Actualiser";
                    clicked => { root.select-capture("", "", ""); AppState.refresh-library(); }
                }
                AppButton {
                    height: 32px;
                    compact: true;
                    text: "Afficher les fichiers";
                    clicked => { AppState.open-capture-directory(); }
                }
            }
        }

        if AppState.pending-recordings-count > 0: Rectangle {
            height: max(56px, recovery-content.preferred-height);
            vertical-stretch: 0;
            border-radius: Design.card-radius;
            background: Design.info-surface;
            border-width: 1px;
            border-color: Design.border;
            recovery-content := HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Text {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    text: AppState.pending-recordings-count == 1
                    ? "Une vidéo interrompue peut être récupérée."
                    : AppState.pending-recordings-count + " vidéos interrompues peuvent être récupérées.";
                    color: Design.text;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                    vertical-alignment: center;
                }
                AppButton {
                    height: 32px;
                    compact: true;
                    text: "Récupérer";
                    accessibility-label: "Récupérer les vidéos interrompues";
                    clicked => { AppState.recover-pending-recordings(); }
                }
            }
        }

        if !AppState.library-loading && AppState.library-error == ""
            && AppState.selected-library-path != "" && AppState.selected-library-dossier-number == "" && AppState.patient-id != "": Rectangle {
            height: assignment-content.preferred-height;
            vertical-stretch: 0;
            border-radius: Design.card-radius;
            background: Design.accent-soft;
            border-width: 1px;
            border-color: Design.accent;
            assignment-content := VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;
                Text {
                    text: AppState.recording-busy
                    ? "Terminez la vidéo avant de rattacher cette capture au dossier n° " + AppState.patient-dossier-number + "."
                    : root.confirming-assignment
                    ? "Cette capture appartient-elle bien au dossier n° " + AppState.patient-dossier-number + " ?"
                    : "Capture sans dossier patient vérifié. Dossier actif : n° " + AppState.patient-dossier-number + ".";
                    color: Design.text;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 0;
                }
                HorizontalLayout {
                    height: 32px;
                    vertical-stretch: 0;
                    spacing: 8px;
                    alignment: start;
                    AppButton {
                        height: 32px;
                        compact: true;
                        primary: root.confirming-assignment;
                        enabled: !AppState.patient-action-pending && !AppState.recording-busy;
                        text: AppState.patient-action-pending ? "Rattachement en cours…" : root.confirming-assignment ? "Confirmer le rattachement" : "Rattacher au dossier n° " + AppState.patient-dossier-number;
                        clicked => {
                            if root.confirming-assignment {
                                AppState.assign-selected-capture-to-patient(AppState.selected-library-path, AppState.selected-library-file-version);
                                root.confirmation-patient-id = "";
                            } else {
                                root.confirmation-patient-id = AppState.patient-id;
                                root.confirmation-capture-path = AppState.selected-library-path;
                                root.confirmation-file-version = AppState.selected-library-file-version;
                            }
                        }
                    }
                    if root.confirming-assignment: AppButton {
                        height: 32px;
                        compact: true;
                        quiet: true;
                        text: "Annuler";
                        clicked => { root.confirmation-patient-id = ""; }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 32px;
            vertical-stretch: 0;
            spacing: Design.gap-small;
            AppButton {
                height: 32px;
                compact: true;
                text: "Tous";
                primary: false;
                checkable: true;
                selected: AppState.library-filter == 0;
                clicked => {
                    root.select-capture("", "", "");
                    AppState.library-filter = 0;
                    AppState.library-filter-changed(0);
                }
            }
            AppButton {
                height: 32px;
                compact: true;
                text: "Photos";
                primary: false;
                checkable: true;
                selected: AppState.library-filter == 1;
                clicked => {
                    root.select-capture("", "", "");
                    AppState.library-filter = 1;
                    AppState.library-filter-changed(1);
                }
            }
            AppButton {
                height: 32px;
                compact: true;
                text: "Vidéos";
                primary: false;
                checkable: true;
                selected: AppState.library-filter == 2;
                clicked => {
                    root.select-capture("", "", "");
                    AppState.library-filter = 2;
                    AppState.library-filter-changed(2);
                }
            }
            AppButton {
                height: 32px;
                compact: true;
                text: AppState.patient-dossier-number == "" ? "Dossier actif" : "Dossier n° " + AppState.patient-dossier-number;
                accessibility-label: AppState.patient-id == "" ? "Choisissez un dossier dans Caméra pour filtrer ses captures" : "Afficher les captures du dossier n° " + AppState.patient-dossier-number;
                primary: false;
                checkable: true;
                selected: AppState.library-filter == 3;
                enabled: AppState.patient-id != "";
                clicked => {
                    root.select-capture("", "", "");
                    AppState.library-filter = 3;
                    AppState.library-filter-changed(3);
                }
            }
            AppComboBox {
                width: 160px; height: 32px;
                model: ["Tous les yeux", "Œil gauche", "Œil droit", "Œil non renseigné"];
                current-index <=> AppState.library-query-eye;
                accessible-label: "Filtrer par œil";
                selected => { AppState.apply-library-query(); }
            }
            AppComboBox {
                width: 146px; height: 32px; model: ["Plus récentes", "Plus anciennes"];
                current-index <=> AppState.library-query-sort;
                accessible-label: "Trier les captures par date";
                selected => { AppState.apply-library-query(); }
            }
            Rectangle { min-width: 0px; horizontal-stretch: 1; background: transparent; }
        }
        HorizontalLayout {
            height: 56px; vertical-stretch: 0; spacing: 8px;
            VerticalLayout {
                width: 146px; horizontal-stretch: 0; spacing: 4px;
                Text { height: 16px; text: "Dossier"; color: Design.text-secondary; font-size: 12px; }
                LineEdit {
                    height: 36px; min-width: 0px;
                    text <=> AppState.library-query-dossier;
                    placeholder-text: "D-000123";
                    accessible-label: "Rechercher un numéro de dossier";
                    changed has-focus => { AppState.focused-text-fields = max(0, AppState.focused-text-fields + (self.has-focus ? 1 : -1)); }
                    accepted => { AppState.apply-library-query(); }
                }
            }
            DateField { width: 194px; horizontal-stretch: 0; label: "Du"; target: 1; below-clearance: 48px; value <=> AppState.library-query-from; }
            DateField { width: 194px; horizontal-stretch: 0; label: "Au"; target: 2; below-clearance: 48px; value <=> AppState.library-query-to; }
            VerticalLayout {
                padding-top: 20px; spacing: 0px; horizontal-stretch: 0;
                AppButton { height: 36px; compact: true; text: "Appliquer"; clicked => { AppState.apply-library-query(); } }
            }
            VerticalLayout {
                padding-top: 20px; spacing: 0px; horizontal-stretch: 0;
                AppButton { height: 36px; compact: true; quiet: true; text: "Effacer";
                    clicked => { AppState.library-query-dossier = ""; AppState.library-query-from = ""; AppState.library-query-to = ""; AppState.library-query-eye = 0; AppState.library-query-sort = 0; AppState.apply-library-query(); }
                }
            }
            Rectangle { min-width: 0px; horizontal-stretch: 1; background: transparent; }
        }
        HorizontalLayout {
            height: 36px; vertical-stretch: 0; spacing: 12px;
            HorizontalLayout {
                height: 32px;
                vertical-stretch: 0;
                spacing: 6px;
                AppButton {
                    height: 32px;
                    compact: true;
                    text: "Grille";
                    primary: false;
                    checkable: true;
                    selected: AppState.library-view == 0;
                    clicked => { AppState.library-view = 0; }
                }
                AppButton {
                    height: 32px;
                    compact: true;
                    text: "Liste";
                    primary: false;
                    checkable: true;
                    selected: AppState.library-view == 1;
                    clicked => { AppState.library-view = 1; }
                }
            }
            Text { text: "Miniatures"; color: Design.text-secondary; font-size: 12px; vertical-alignment: center; }
            ThumbnailSizeControl { width: min(400px, root.width - 2 * root.content-inset - 236px); }
            Rectangle { min-width: 0px; horizontal-stretch: 1; background: transparent; }
        }
        if AppState.library-query-error != "": Text { text: AppState.library-query-error; color: Design.danger; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }

        if AppState.library-loading: Rectangle {
            background: Design.surface;
            border-radius: Design.card-radius;
            min-height: 0px;
            vertical-stretch: 1;
            Text {
                text: "Chargement des captures…";
                color: Design.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !AppState.library-loading && AppState.library-error != "": Rectangle {
            background: Design.surface;
            border-radius: Design.card-radius;
            border-width: 1px;
            border-color: Design.error-surface;
            min-height: 0px;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                alignment: center;
                spacing: 10px;
                Text {
                    text: AppState.library-error;
                    color: Design.danger;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    AppButton {
                        height: 32px;
                        compact: true;
                        primary: true;
                        text: "Réessayer";
                        clicked => { AppState.refresh-library(); }
                    }
                    AppButton {
                        height: 32px;
                        compact: true;
                        quiet: true;
                        text: "Vérifier le dossier";
                        clicked => { AppState.navigate-to(4); }
                    }
                }
            }
        }

        if !AppState.library-loading && AppState.library-error == "" && AppState.library-items.length == 0: Rectangle {
            background: Design.surface;
            border-radius: Design.card-radius;
            border-width: 1px;
            border-color: Design.border;
            min-height: 0px;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                alignment: center;
                spacing: 8px;
                Text {
                    text: AppState.library-query-active ? "Aucune capture pour cette recherche" : AppState.library-filter == 3
                    ? "Aucune capture pour ce patient."
                    : AppState.library-filter == 1
                    ? "Aucune photo dans la bibliothèque."
                    : AppState.library-filter == 2
                    ? "Aucune vidéo dans la bibliothèque."
                    : "Aucun cliché dans la bibliothèque pour le moment.";
                    color: Design.text;
                    font-size: 16px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: AppState.library-query-active ? "Modifiez le dossier, l’œil ou la période recherchés." : AppState.library-filter == 0
                    ? "Prenez une photo ou une vidéo depuis la caméra pour commencer."
                    : "Essayez un autre filtre pour retrouver vos captures.";
                    color: Design.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: center;
                    AppButton {
                        height: 32px;
                        compact: true;
                        primary: true;
                        text: AppState.library-query-active ? "Effacer la recherche" : AppState.library-filter == 0 ? "Ouvrir la caméra" : "Voir toutes les captures";
                        clicked => {
                            if AppState.library-query-active {
                                AppState.library-query-dossier = ""; AppState.library-query-from = ""; AppState.library-query-to = ""; AppState.library-query-eye = 0; AppState.library-query-sort = 0; AppState.apply-library-query();
                            } else if AppState.library-filter == 0 {
                                AppState.navigate-to(0);
                            } else {
                                root.select-capture("", "", "");
                                AppState.library-filter = 0;
                                AppState.library-filter-changed(0);
                            }
                        }
                    }
                }
            }
        }

        if !AppState.library-loading && AppState.library-error == "" && AppState.library-items.length > 0 && AppState.library-view == 1: Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
            // ListView accepts only its repeater; the timer belongs to its wrapper.
            Timer {
                interval: 80ms;
                running: true;
                triggered => { AppState.library-visible-range-changed(library-list.first-visible, library-list.end-visible); }
            }
            library-list := ListView {
                width: parent.width;
                height: parent.height;
                private property <int> first-visible: max(0, floor(-self.viewport-y / root.list-row-height));
                private property <int> end-visible: min(AppState.library-items.length, self.first-visible + ceil(self.visible-height / root.list-row-height) + 1);
                for item in AppState.library-items: Rectangle {
                    width: library-list.visible-width;
                    height: root.list-row-height;

                    Rectangle {
                        width: 100%;
                        height: root.list-row-height - 8px;
                        border-radius: Design.card-radius;
                        background: AppState.selected-library-path == item.file-path ? Design.accent-soft : list-card-pointer.has-hover || item.is-current-patient ? Design.surface-raised : Design.surface;
                        border-width: 1px;
                        border-color: AppState.selected-library-path == item.file-path ? Design.accent : Design.border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            alignment: space-between;

                            Rectangle {
                                min-width: 0px;
                                horizontal-stretch: 1;
                                background: transparent;
                                border-radius: 6px;
                                border-width: list-card-focus.has-focus ? 2px : 0px;
                                border-color: Design.focus;
                                accessible-role: button;
                                accessible-label: "Sélectionner " + item.title + ", " + item.date-time;
                                accessible-description: AppState.selected-library-path == item.file-path ? "Capture sélectionnée" : item.is-current-patient ? "Capture du dossier actif" : "";
                                accessible-action-default => { root.select-capture(item.file-path, item.dossier-number, item.file-version); }
                                forward-focus: list-card-focus;
                                HorizontalLayout {
                                    padding: 2px;
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    spacing: 12px;
                                    alignment: start;

                                    Rectangle {
                                        width: root.list-image-width;
                                        vertical-stretch: 1;
                                        background: transparent;

                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: root.list-image-width;
                                            height: root.list-image-height;
                                            border-radius: 6px;
                                            clip: true;
                                            background: item.has-thumbnail ? Design.preview : Design.surface-sunken;

                                            if item.has-thumbnail: Image {
                                                source: item.thumbnail;
                                                width: 100%;
                                                height: 100%;
                                                // Show the whole iris, including its edge.
                                                image-fit: contain;
                                            }

                                            if !item.has-thumbnail: Text {
                                                text: item.is-video ? "VIDÉO" : "IRIS";
                                                color: Design.text-muted;
                                                font-size: 12px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        width: 48px;
                                        vertical-stretch: 1;
                                        background: transparent;

                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            width: 48px;
                                            height: 20px;
                                            border-radius: 6px;
                                            background: item.is-video ? Design.video-surface : Design.success-surface;
                                            Text {
                                                text: item.is-video ? "VIDÉO" : "PHOTO";
                                                color: item.is-video ? Design.accent : Design.success;
                                                font-size: 12px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            min-width: 0px;
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                min-width: 0px;
                                                horizontal-stretch: 1;
                                                text: item.title;
                                                color: Design.text;
                                                font-size: 14px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }


                                        }

                                        Text {
                                            text: item.dossier-number == "" ? item.date-time : "Dossier n° " + item.dossier-number + " · " + item.date-time;
                                            color: Design.text-muted;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                }
                                Tooltip { y: parent.height + 6px; text: item.title + "\n" + item.date-time; active: list-card-pointer.has-hover && !list-card-pointer.pressed; }
                                list-card-pointer := TouchArea {
                                    clicked => { list-card-focus.focus(); root.select-capture(item.file-path, item.dossier-number, item.file-version); }
                                }
                                list-card-focus := FocusScope {
                                    width: 0px;
                                    key-pressed(event) => {
                                        if event.text == " " || event.text == "\n" {
                                            root.select-capture(item.file-path, item.dossier-number, item.file-version);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                            }

                            Rectangle {
                                width: list-actions.preferred-width;
                                horizontal-stretch: 0;
                                vertical-stretch: 1;
                                background: transparent;
                                list-actions := HorizontalLayout {
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width;
                                    height: 32px;
                                    spacing: 6px;
                                    if item.can-open-in-app: AppButton {
                                        height: 32px;
                                        compact: true;
                                        text: "Ouvrir";
                                        accessibility-label: "Ouvrir " + item.title + " dans Iriscope";
                                        enabled: item.can-open-in-app;
                                        primary: AppState.selected-library-path == item.file-path;
                                        clicked => { AppState.library-map-open = false; AppState.open-capture-file(item.file-path, item.file-version); }
                                    }
                                    AppButton {
                                        height: 32px;
                                        compact: true;
                                        quiet: item.can-open-in-app;
                                        primary: !item.can-open-in-app && AppState.selected-library-path == item.file-path;
                                        text: item.can-open-in-app ? "Autre app" : "Ouvrir avec une app";
                                        accessibility-label: "Ouvrir " + item.title + " avec l'application système";
                                        clicked => { AppState.open-capture-externally(item.file-path, item.file-version); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if !AppState.library-loading && AppState.library-error == "" && AppState.library-items.length > 0 && AppState.library-view == 0: library-grid := ScrollView {
            private property <length> row-height: root.thumbnail-height + 128px;
            private property <int> first-visible: max(0, floor(-self.viewport-y / self.row-height)) * root.library-grid-columns;
            private property <int> end-visible: min(AppState.library-items.length, self.first-visible + (ceil(self.visible-height / self.row-height) + 1) * root.library-grid-columns);
            // Geometry is read after layout, never during conditional creation.
            Timer {
                interval: 80ms;
                running: true;
                triggered => { AppState.library-visible-range-changed(library-grid.first-visible, library-grid.end-visible); }
            }

            min-height: 0px;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;

            GridLayout {
                width: root.library-grid-columns * root.card-width + (root.library-grid-columns - 1) * 12px;
                spacing: 12px;

                for item[index] in AppState.library-items: Rectangle {
                    row: index / root.library-grid-columns;
                    col: Math.mod(index, root.library-grid-columns);
                    width: root.card-width;
                    horizontal-stretch: 0;
                    height: root.thumbnail-height + 116px;
                    border-radius: Design.card-radius;
                    clip: true;
                    background: AppState.selected-library-path == item.file-path ? Design.accent-soft : grid-card-pointer.has-hover || item.is-current-patient ? Design.surface-raised : Design.surface;
                    border-width: 1px;
                    border-color: AppState.selected-library-path == item.file-path ? Design.accent : Design.border;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        alignment: start;

                        Rectangle {
                            min-width: 0px;
                            horizontal-stretch: 1;
                            height: root.thumbnail-height + 54px;
                            vertical-stretch: 0;
                            background: transparent;
                            border-radius: 6px;
                            border-width: grid-card-focus.has-focus ? 2px : 0px;
                            border-color: Design.focus;
                            accessible-role: button;
                            accessible-label: "Sélectionner " + item.title + ", " + item.date-time;
                            accessible-description: AppState.selected-library-path == item.file-path ? "Capture sélectionnée" : item.is-current-patient ? "Capture du dossier actif" : "";
                            accessible-action-default => { root.select-capture(item.file-path, item.dossier-number, item.file-version); }
                            forward-focus: grid-card-focus;
                            VerticalLayout {
                                padding: 2px;
                                spacing: 6px;
                                Rectangle {
                                    height: root.thumbnail-height;
                                    vertical-stretch: 0;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Design.preview;

                                    if item.has-thumbnail: Image {
                                        source: item.thumbnail;
                                        width: 100%;
                                        height: 100%;
                                        // Show the whole iris, including its edge.
                                        image-fit: contain;
                                    }

                                    if !item.has-thumbnail: Text {
                                        width: 100%;
                                        height: 100%;
                                        text: item.is-video ? "VIDÉO" : "IRIS";
                                        color: Design.overlay-text-muted;
                                        font-size: 12px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 54px;
                                        height: 18px;
                                        border-radius: 4px;
                                        background: item.is-video ? Design.video-surface : Design.success-surface;
                                        Text {
                                            text: item.is-video ? "VIDÉO" : "PHOTO";
                                            color: item.is-video ? Design.accent : Design.success;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                        text: item.title;
                                        color: Design.text;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    height: 20px;
                                    text: item.dossier-number == "" ? item.date-time : "Dossier n° " + item.dossier-number + " · " + item.date-time;
                                    color: Design.text-muted;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                            }
                            Tooltip { y: parent.height + 6px; text: item.title + "\n" + item.date-time; active: grid-card-pointer.has-hover && !grid-card-pointer.pressed; }
                            grid-card-pointer := TouchArea {
                                clicked => { grid-card-focus.focus(); root.select-capture(item.file-path, item.dossier-number, item.file-version); }
                            }
                            grid-card-focus := FocusScope {
                                width: 0px;
                                key-pressed(event) => {
                                    if event.text == " " || event.text == "\n" {
                                        root.select-capture(item.file-path, item.dossier-number, item.file-version);
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }

                        HorizontalLayout {
                            height: 32px;
                            vertical-stretch: 0;
                            spacing: 6px;
                            if item.can-open-in-app: AppButton {
                                height: 32px;
                                min-width: 0px; horizontal-stretch: 1; elide-text: true;
                                compact: true;
                                text: "Ouvrir";
                                accessibility-label: "Ouvrir " + item.title + " dans Iriscope";
                                enabled: item.can-open-in-app;
                                primary: AppState.selected-library-path == item.file-path;
                                clicked => { AppState.library-map-open = false; AppState.open-capture-file(item.file-path, item.file-version); }
                            }
                            AppButton {
                                height: 32px;
                                min-width: 0px; horizontal-stretch: 1; elide-text: true;
                                compact: true;
                                quiet: item.can-open-in-app;
                                primary: !item.can-open-in-app && AppState.selected-library-path == item.file-path;
                                text: item.can-open-in-app ? "Autre app" : "Ouvrir avec une app";
                                accessibility-label: "Ouvrir " + item.title + " avec l'application système";
                                clicked => { AppState.open-capture-externally(item.file-path, item.file-version); }
                            }
                        }
                    }
                }
            }
        }
        if AppState.library-total-count > 100: HorizontalLayout {
            height: 32px;
            vertical-stretch: 0;
            spacing: 8px;
            alignment: start;
            AppButton {
                height: 32px;
                compact: true;
                text: "Précédent";
                enabled: AppState.library-page > 0 && !AppState.library-loading;
                clicked => { root.select-capture("", "", ""); AppState.library-page-changed(AppState.library-page - 1); }
            }
            Text {
                text: AppState.library-page-summary;
                color: Design.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
            }
            AppButton {
                height: 32px;
                compact: true;
                text: "Suivant";
                enabled: (AppState.library-page + 1) * 100 < AppState.library-total-count && !AppState.library-loading;
                clicked => { root.select-capture("", "", ""); AppState.library-page-changed(AppState.library-page + 1); }
            }
        }

        HorizontalLayout {
            height: 24px;
            vertical-stretch: 0;
            spacing: 8px;
            Text {
                min-width: 0px;
                horizontal-stretch: 1;
                text: "Noms patients masqués hors dossier actif · Miniatures et fichiers visibles";
                accessible-label: "Noms patients masqués hors dossier actif. Miniatures et noms de fichiers visibles.";
                color: Design.text-muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
