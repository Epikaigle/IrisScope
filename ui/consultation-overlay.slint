import { ResizeHandle } from "./resize-handle.slint";
import { AppButton } from "./controls.slint";
import { LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { AppState } from "./state.slint";
import { Design } from "./theme.slint";
import { SessionPhotoData } from "./models.slint";
component SessionPhotoCard inherits VerticalLayout {
    in property <SessionPhotoData> photo;
    height: 210px; spacing: 4px;
    Image { height: 146px; source: root.photo.thumbnail; image-fit: contain; }
    Text { height: 20px; text: root.photo.caption; color: root.photo.retained ? Design.overlay-accent : Design.overlay-text-secondary; overflow: elide; }
    AppButton { height: 32px; compact: true; overlay: true; text: "Ouvrir"; clicked => {AppState.open-capture-file(root.photo.path,root.photo.version);} }
}
component DossierSearch inherits VerticalLayout {
    spacing: 8px;
    search-timer := Timer { interval: 300ms; triggered => { AppState.search-dossiers(); } }
    LineEdit {
        height: 36px; text <=> AppState.dossier-search;
        placeholder-text: "Nom ou numéro D-000123";
        accessible-label: "Rechercher un dossier par nom ou numéro";
        edited => { search-timer.restart(); }
        accepted => { AppState.search-dossiers(); }
    }
    Text {
        text: AppState.dossier-search-busy ? "Recherche…" : AppState.dossier-search == ""
            ? "Saisissez le nom de la personne ou son numéro de dossier."
            : AppState.dossier-candidates.length == 0 ? "Aucun dossier trouvé." : "Sélectionnez un dossier dans les résultats.";
        color: Design.overlay-text-secondary; font-size: 12px; wrap: word-wrap;
    }
    if AppState.dossier-candidates.length > 0: results := ScrollView {
        height: min(180px, AppState.dossier-candidates.length * 48px);
        horizontal-scrollbar-policy: always-off;
        VerticalLayout {
            width: max(0px, results.visible-width - (AppState.dossier-candidates.length * 48px > 180px ? Design.scroll-gutter : 0px));
            alignment: start; spacing: 4px;
            for p in AppState.dossier-candidates: AppButton {
                height: 44px; compact: true; overlay: true; left-aligned: true; elide-text: true; wrap-text: true;
                text: p.first-name + " " + p.last-name + " · " + p.dossier-number;
                selected: AppState.consultation-patient-id == p.id; checkable: true;
                enabled: !AppState.consultation-dirty && !AppState.consultation-saving;
                clicked => { AppState.select-dossier(p.id); }
            }
        }
    }
}
export component ConsultationOverlay inherits Rectangle {
    private property <length> panel-width: clamp(AppState.consultation-panel-width == 0 ? (root.width < 900px ? 220px : 280px) : AppState.consultation-panel-width * 1px,200px,max(200px,min(400px,root.width - 540px)));
    background: Design.overlay-surface;
    TouchArea { clicked => {} }
    private property <int> revision: AppState.consultation-revision;
    changed revision => { if AppState.consultation-dirty && !AppState.consultation-saving { save-timer.restart(); } }
    save-timer := Timer {
        interval: 700ms; running: AppState.consultation-dirty && !AppState.consultation-saving && !AppState.consultation-paused && !AppState.consultation-load-error;
        triggered => { AppState.save-consultation-notes(); }
    }
    VerticalLayout {
        padding: root.width < 900px ? 12px : 20px; spacing: 12px;
        HorizontalLayout {
            height: 36px; vertical-stretch: 0; spacing: 8px;
            Text { min-width: 0px; horizontal-stretch: 1; text: "Dossiers et séances"; color: Design.overlay-text; font-size: 22px; font-weight: 600; }
            AppButton { compact: true; overlay: true; text: "Fermer"; clicked => { AppState.close-consultation(); } }
        }
        if AppState.consultation-feedback != "": Text { text: AppState.consultation-feedback; color: Design.overlay-danger; wrap: word-wrap; vertical-stretch: 0; }
        if AppState.consultation-title == "": Rectangle {
            background: transparent; min-height: 0px; vertical-stretch: 1;
            Rectangle {
                width: min(520px, parent.width); height: min(parent.height, welcome.preferred-height);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Design.card-radius; border-width: 1px; border-color: Design.overlay-border;
                background: Design.overlay-panel;
                welcome := VerticalLayout {
                    padding: 24px; spacing: 16px; alignment: start;
                    Text { text: "Retrouver une séance"; font-size: 20px; font-weight: 600; color: Design.overlay-text; }
                    Text { text: "Chaque dossier regroupe les photos et les notes de la personne, classées par date de séance."; color: Design.overlay-text-secondary; wrap: word-wrap; }
                    DossierSearch { }
                    Text { text: "Pour créer un dossier, renseignez le patient dans l’écran Caméra."; color: Design.overlay-text-muted; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
        if AppState.consultation-title != "": HorizontalLayout {
            spacing: 12px; min-height: 0px; vertical-stretch: 1;
            VerticalLayout {
                width: root.panel-width; horizontal-stretch: 0; spacing: 8px; min-height: 0px;
                Text { text: "Dossier"; color: Design.overlay-text; font-weight: 600; }
                DossierSearch { vertical-stretch: 0; }
                Text { text: "Séances par date"; color: Design.overlay-text; font-weight: 600; }
                days-scroll := ScrollView {
                    min-height: 0px; vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: max(0px, days-scroll.visible-width - Design.scroll-gutter);
                        alignment: start; spacing: 4px;
                        for day in AppState.consultation-days: AppButton {
                            height: 64px; compact: true; wrap-text: true; overlay: true; left-aligned: true; elide-text: true;
                            text: day.label + "\nGauche : " + day.left + " · Droit : " + day.right + " · Vidéos : " + day.videos;
                            tooltip: "Prises du " + day.label + " · " + day.videos + " vidéo(s), visibles dans la bibliothèque";
                            selected: AppState.consultation-day == day.date; checkable: true;
                            enabled: !AppState.consultation-loading; clicked => { AppState.select-consultation-day(day.date); }
                        }
                        if AppState.consultation-days.length == 0: Text { text: "Ce dossier n’a pas encore de séance enregistrée."; color: Design.overlay-text-secondary; wrap: word-wrap; }
                    }
                }
                if AppState.consultation-patient-id != "": AppButton {
                    height: 32px; compact: true; overlay: true; text: "Utiliser pour la capture";
                    enabled: !AppState.consultation-dirty && !AppState.consultation-saving && !AppState.recording-busy;
                    clicked => { AppState.select-patient(AppState.consultation-patient-id); AppState.close-consultation(); AppState.navigate-to(0); }
                }
            }
            ResizeHandle {
                panel-width: root.panel-width; minimum: 200px; maximum: max(200px,min(400px,root.width - 540px)); overlay: true;
                label: "Largeur de la liste des dossiers et des dates";
                resized(value) => { AppState.consultation-panel-width = round(value/1px); }
                committed => { AppState.interface-edited(); }
            }
            VerticalLayout {
                min-width: 0px; horizontal-stretch: 1; min-height: 0px; spacing: 8px;
                Text { text: AppState.consultation-title; color: Design.overlay-text; font-size: 17px; overflow: elide; }
                if AppState.consultation-loading: Text { text: "Chargement des prises…"; color: Design.overlay-text-secondary; }
                if AppState.consultation-day == "": Text { text: "Choisissez une date pour consulter les photos et les notes de la séance."; color: Design.overlay-text-secondary; wrap: word-wrap; }
                if AppState.consultation-day != "": VerticalLayout {
                    spacing: 6px; vertical-stretch: 0;
                    Text { text: "Notes de la séance"; color: Design.overlay-text; font-weight: 600; }
                    TextEdit { height: root.height < 700px ? 84px : 120px; text <=> AppState.consultation-notes; wrap: word-wrap; enabled: !AppState.consultation-loading && !AppState.consultation-load-error; accessible-label: "Notes générales de cette séance"; edited => { AppState.consultation-edited(); } }
                    HorizontalLayout {
                        height: 32px; spacing: 8px;
                        Text { min-width: 0px; horizontal-stretch: 1; text: AppState.consultation-load-error ? "Notes indisponibles" : AppState.consultation-paused ? "Échec · brouillon conservé" : AppState.consultation-saving ? "Enregistrement…" : AppState.consultation-dirty ? "Modifications en attente" : AppState.consultation-saved-at == "" ? "Aucune modification" : "Enregistré · " + AppState.consultation-saved-at; color: AppState.consultation-paused || AppState.consultation-load-error ? Design.overlay-danger : Design.overlay-success; font-size: 12px; wrap: word-wrap; }
                        AppButton { compact: true; overlay: true; text: "Enregistrer"; enabled: AppState.consultation-dirty && !AppState.consultation-saving && !AppState.consultation-load-error; clicked => { AppState.save-consultation-notes(); } }
                    }
                    if AppState.consultation-paused: AppButton { height: 32px; compact: true; overlay: true; text: "Fermer sans enregistrer"; clicked => { AppState.consultation-dirty = false; AppState.close-consultation(); } }
                }
                if AppState.consultation-day != "": photos-scroll := ScrollView {
                    min-height: 0px; vertical-stretch: 1; horizontal-scrollbar-policy: always-off;
                    HorizontalLayout {
                        width: max(0px, photos-scroll.visible-width - Design.scroll-gutter);
                        alignment: start; spacing: 12px;
                        VerticalLayout {
                            min-width: 0px; horizontal-stretch: 1; alignment: start; spacing: 8px;
                            Text { text: "Œil gauche"; color: Design.overlay-text; font-weight: 600; }
                            if AppState.consultation-left-photos.length == 0: Text { text: "Aucune photo pour cette date"; color: Design.overlay-text-secondary; wrap: word-wrap; }
                            for item in AppState.consultation-left-photos: SessionPhotoCard { photo: item; }
                        }
                        VerticalLayout {
                            min-width: 0px; horizontal-stretch: 1; alignment: start; spacing: 8px;
                            Text { text: "Œil droit"; color: Design.overlay-text; font-weight: 600; }
                            if AppState.consultation-right-photos.length == 0: Text { text: "Aucune photo pour cette date"; color: Design.overlay-text-secondary; wrap: word-wrap; }
                            for item in AppState.consultation-right-photos: SessionPhotoCard { photo: item; }
                        }
                    }
                }
                if AppState.consultation-day == "": Rectangle { min-height: 0px; vertical-stretch: 1; background: transparent; }
                Text { text: "Jusqu’à 200 photos par date · vidéos accessibles dans la bibliothèque"; color: Design.overlay-text-secondary; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
            }
        }
    }
}
