import { Button, VerticalBox, HorizontalBox, LineEdit, Slider, ComboBox, ScrollView } from "std-widgets.slint";

export struct DiagnosticData {
    device-name: string,
    device-id: string,
    backend-name: string,
    usb-info: string,
    active-format: string,
    active-resolution: string,
    active-fps: string,
    measured-fps: string,
    decode-time-ms: string,
    frame-count: int,
    dropped-frames: int,
}

export struct LibraryItemData {
    id: string,
    file-path: string,
    title: string,
    date-time: string,
    eye-label: string,
    thumbnail: image,
    has-thumbnail: bool,
    is-video: bool,
    is-current-session: bool,
}

export struct CameraControlUiData {
    key: string,
    name: string,
    kind: int, // 0: integer, 1: boolean, 2: menu
    minimum: float,
    maximum: float,
    value: float,
    boolean-value: bool,
    menu-label: string,
    read-only: bool,
}

export component MainWindow inherits Window {
    title: "IrisScope - Digital Microscope";
    min-width: 1024px;
    min-height: 720px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: #14171a;

    in-out property <image> live-frame;
    in-out property <string> status-text: "Recherche de l'iridoscope...";
    in-out property <bool> camera-connected: false;
    in-out property <bool> is-streaming: false;

    // Session patient
    in-out property <string> patient-first-name: "";
    in-out property <string> patient-last-name: "";
    in-out property <int> selected-eye: 0; // 0: Non renseigné, 1: Gauche, 2: Droit
    in-out property <bool> is-video-mode: false;
    in-out property <bool> is-recording: false;
    in-out property <string> recording-duration: "00:00";

    // Transformations d'affichage live
    in-out property <bool> is-frozen: false;
    in-out property <int> zoom-level: 100; // 100, 150, 200
    in-out property <length> zoom-pan-x: 0px;
    in-out property <length> zoom-pan-y: 0px;
    in-out property <int> rotation-angle: 0; // 0, 90, 180, 270
    in-out property <bool> mirror-horizontal: false;
    in-out property <bool> mirror-vertical: false;

    // Navigation (0: Camera, 1: Controls, 2: Library, 3: Iridology, 4: Settings)
    in-out property <int> current-tab: 0;

    // Diagnostic
    in-out property <DiagnosticData> diagnostics;

    // Dernier enregistrement & Flash
    in-out property <string> last-capture-message: "";
    in-out property <bool> show-last-capture: false;
    in-out property <float> shutter-flash-opacity: 0.0;
    in-out property <image> last-capture-thumbnail;
    in-out property <bool> has-last-capture: false;
    in-out property <string> last-capture-file-name: "";
    in-out property <string> last-capture-path: "";
    in-out property <int> session-photo-count: 0;

    // Réglages caméra détectés au runtime
    in-out property <[CameraControlUiData]> camera-controls: [];

    // Préférences persistantes
    in-out property <string> settings-capture-directory: "";
    in-out property <string> settings-filename-template: "";
    in-out property <int> settings-button-mode: 0; // 0 suit le mode, 1 photo, 2 vidéo
    in-out property <string> settings-iridology-map-path: "";
    in-out property <string> settings-iridology-symbols-path: "";

    // Références visuelles d'iridologie
    in-out property <image> iridology-map-image;
    in-out property <image> iridology-symbols-image;
    in-out property <bool> has-iridology-map: false;
    in-out property <bool> has-iridology-symbols: false;
    in-out property <int> iridology-reference-mode: 0; // 0 carte, 1 signes
    in-out property <int> iridology-reference-zoom: 100;
    in-out property <length> iridology-reference-pan-x: 0px;
    in-out property <length> iridology-reference-pan-y: 0px;

    // Bibliothèque
    in-out property <[LibraryItemData]> library-items: [];
    in-out property <int> library-filter: 0; // 0 tous, 1 photos, 2 vidéos, 3 session
    callback open-capture-file(string);

    // Grille iridologique
    in-out property <bool> show-iridology-grid: false;

    // Visionneuse privée intégrée
    in-out property <bool> viewer-open: false;
    in-out property <image> viewer-image;
    in-out property <int> viewer-zoom: 100;
    in-out property <length> viewer-pan-x: 0px;
    in-out property <length> viewer-pan-y: 0px;
    in-out property <bool> viewer-is-video: false;
    in-out property <bool> viewer-video-playing: false;

    // Callbacks
    callback trigger-capture();
    callback toggle-recording();
    callback clear-session();
    callback toggle-freeze();
    callback reset-camera-controls();
    callback set-camera-control-value(string, float);
    callback set-camera-control-bool(string, bool);
    callback cycle-camera-control-menu(string);
    callback refresh-library();
    callback open-capture-directory();
    callback update-capture-directory(string);
    callback update-filename-template(string);
    callback cycle-physical-button-mode();
    callback update-iridology-map-path(string);
    callback update-iridology-symbols-path(string);
    callback close-viewer();
    callback toggle-viewer-video();

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // Top Navigation Bar
        Rectangle {
            height: 52px;
            background: #1c2127;

            HorizontalBox {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                HorizontalBox {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: "IrisScope";
                        color: #4da3ff;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 1px;
                        height: 24px;
                        background: #2f3842;
                    }

                    Button {
                        text: "Caméra";
                        primary: root.current-tab == 0;
                        clicked => { root.current-tab = 0; }
                    }

                    Button {
                        text: "Réglages Image";
                        primary: root.current-tab == 1;
                        clicked => { root.current-tab = 1; }
                    }

                    Button {
                        text: "Bibliothèque";
                        primary: root.current-tab == 2;
                        clicked => {
                            root.current-tab = 2;
                            root.library-filter =
                                root.patient-first-name != "" && root.patient-last-name != ""
                                    ? 3
                                    : 0;
                            root.refresh-library();
                        }
                    }

                    Button {
                        text: "Carte d'iridologie";
                        primary: root.current-tab == 3;
                        clicked => { root.current-tab = 3; }
                    }

                    Button {
                        text: "Paramètres & Diagnostic";
                        primary: root.current-tab == 4;
                        clicked => { root.current-tab = 4; }
                    }
                }

                HorizontalBox {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        border-radius: 12px;
                        background: root.camera-connected ? #173822 : #381a1a;
                        height: 28px;

                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.camera-connected ? #34d399 : #f87171;
                            }

                            Text {
                                text: root.status-text;
                                color: root.camera-connected ? #6ee7b7 : #fca5a5;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Main Viewport Container
        Rectangle {
            background: #0f1215;

            // Tab 0: Camera Live View
            if root.current-tab == 0: VerticalBox {
                padding: 12px;
                spacing: 12px;

                // Live Camera viewport
                live-viewport := Rectangle {
                    clip: true;
                    border-radius: 8px;
                    background: #000000;

                    if root.is-streaming: Image {
                        source: root.live-frame;
                        private property <bool> quarter-turn:
                            root.rotation-angle == 90 || root.rotation-angle == 270;
                        private property <float> zoom-factor:
                            root.zoom-level == 200 ? 2 : root.zoom-level == 150 ? 1.5 : 1;

                        width: (self.quarter-turn ? parent.height : parent.width)
                            * self.zoom-factor;
                        height: (self.quarter-turn ? parent.width : parent.height)
                            * self.zoom-factor;
                        x: (parent.width - self.width) / 2 + root.zoom-pan-x;
                        y: (parent.height - self.height) / 2 + root.zoom-pan-y;
                        image-fit: contain;

                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                        transform-rotation: root.rotation-angle * 1deg;
                        transform-scale-x: root.mirror-horizontal ? -100% : 100%;
                        transform-scale-y: root.mirror-vertical ? -100% : 100%;
                    }

                    pan-area := TouchArea {
                        enabled: root.is-streaming && root.zoom-level > 100;
                        private property <length> pan-start-x;
                        private property <length> pan-start-y;

                        changed pressed => {
                            if self.pressed {
                                self.pan-start-x = root.zoom-pan-x;
                                self.pan-start-y = root.zoom-pan-y;
                            }
                        }

                        moved => {
                            if self.pressed {
                                root.zoom-pan-x = self.pan-start-x + self.mouse-x - self.pressed-x;
                                root.zoom-pan-y = self.pan-start-y + self.mouse-y - self.pressed-y;
                            }
                        }
                    }

                    if root.is-streaming && root.show-iridology-grid: Rectangle {
                        width: 100%;
                        height: 100%;

                        // 1. Pupil circle
                        Rectangle {
                            x: (parent.width - 60px) / 2;
                            y: (parent.height - 60px) / 2;
                            width: 60px;
                            height: 60px;
                            border-radius: 30px;
                            border-width: 1.5px;
                            border-color: #38bdf8aa;
                        }
                        // 2. Stomach zone
                        Rectangle {
                            x: (parent.width - 140px) / 2;
                            y: (parent.height - 140px) / 2;
                            width: 140px;
                            height: 140px;
                            border-radius: 70px;
                            border-width: 1px;
                            border-color: #38bdf866;
                        }
                        // 3. Collarette (ANW) in amber
                        Rectangle {
                            x: (parent.width - 240px) / 2;
                            y: (parent.height - 240px) / 2;
                            width: 240px;
                            height: 240px;
                            border-radius: 120px;
                            border-width: 1.5px;
                            border-color: #facc15cc;
                        }
                        // 4. Ciliary zone
                        Rectangle {
                            x: (parent.width - 360px) / 2;
                            y: (parent.height - 360px) / 2;
                            width: 360px;
                            height: 360px;
                            border-radius: 180px;
                            border-width: 1px;
                            border-color: #38bdf855;
                        }
                        // 5. Limbic outer ring
                        Rectangle {
                            x: (parent.width - 480px) / 2;
                            y: (parent.height - 480px) / 2;
                            width: 480px;
                            height: 480px;
                            border-radius: 240px;
                            border-width: 1.5px;
                            border-color: #38bdf899;
                        }
                        // Crosshairs
                        Rectangle {
                            x: (parent.width - 1px) / 2;
                            y: (parent.height - 480px) / 2;
                            width: 1px;
                            height: 480px;
                            background: #38bdf855;
                        }
                        Rectangle {
                            x: (parent.width - 480px) / 2;
                            y: (parent.height - 1px) / 2;
                            width: 480px;
                            height: 1px;
                            background: #38bdf855;
                        }
                        // Clock sector guides
                        Text {
                            x: (parent.width - 50px) / 2;
                            y: (parent.height - 480px) / 2 - 18px;
                            text: "12h Cerveau";
                            color: #38bdf8;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                        Text {
                            x: (parent.width - 50px) / 2;
                            y: (parent.height + 480px) / 2 + 4px;
                            text: "6h Reins";
                            color: #38bdf8;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                    }

                    if !root.is-streaming: VerticalBox {
                        alignment: center;
                        spacing: 8px;

                        Text {
                            text: root.camera-connected ? "Démarrage du flux en cours..." : "DE400 non détecté";
                            color: #8b98a5;
                            font-size: 18px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.camera-connected ? "Veuillez patienter" : "Branchez l'iridoscope pour démarrer l'affichage en direct";
                            color: #5b6875;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }

                    // Shutter flash effect
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        background: #ffffff;
                        opacity: root.shutter-flash-opacity;
                        animate opacity { duration: 180ms; easing: ease-out; }
                    }

                    // Recording overlay indicator
                    if root.is-recording: Rectangle {
                        x: 16px;
                        y: 16px;
                        width: 120px;
                        height: 32px;
                        border-radius: 16px;
                        background: #b91c1cb0;

                        HorizontalBox {
                            alignment: center;
                            spacing: 6px;

                            Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: #ef4444;
                            }

                            Text {
                                text: "REC " + root.recording-duration;
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: 700;
                            }
                        }
                    }

                    // Session photo count badge
                    if root.session-photo-count > 0: Rectangle {
                        x: root.is-recording ? 148px : 16px;
                        y: 16px;
                        width: 130px;
                        height: 32px;
                        border-radius: 16px;
                        background: #0f172ae6;
                        border-width: 1.5px;
                        border-color: #38bdf8;

                        HorizontalBox {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: "📸 " + root.session-photo-count + (root.session-photo-count > 1 ? " photos" : " photo");
                                color: #38bdf8;
                                font-size: 13px;
                                font-weight: 700;
                            }
                        }
                    }

                    // Frozen image indicator
                    if root.is-frozen: Rectangle {
                        x: (parent.width - 200px) / 2;
                        y: 16px;
                        width: 200px;
                        height: 32px;
                        border-radius: 16px;
                        background: #0284c7d0;
                        border-width: 1px;
                        border-color: #38bdf8;

                        HorizontalBox {
                            alignment: center;
                            Text {
                                text: "❄ Image Figée";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                            }
                        }
                    }

                    // Toast confirmation overlay
                    if root.show-last-capture: Rectangle {
                        x: (parent.width - 440px) / 2;
                        y: 56px;
                        width: 440px;
                        height: 42px;
                        border-radius: 21px;
                        background: #059669f0;
                        border-width: 1px;
                        border-color: #34d399;

                        HorizontalBox {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: space-between;

                            Text {
                                text: root.last-capture-message;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            if root.has-last-capture: Button {
                                text: "👁 Voir";
                                clicked => { root.open-capture-file(root.last-capture-path); }
                            }
                        }
                    }

                    // Floating Thumbnail Card (Dernière capture)
                    if root.has-last-capture: Rectangle {
                        x: parent.width - 264px;
                        y: parent.height - 120px;
                        width: 248px;
                        height: 104px;
                        border-radius: 10px;
                        background: #14181cf6;
                        border-width: 1.5px;
                        border-color: #38bdf8aa;

                        HorizontalBox {
                            padding: 8px;
                            spacing: 10px;
                            alignment: start;

                            // Thumbnail
                            Rectangle {
                                width: 88px;
                                height: 88px;
                                border-radius: 6px;
                                clip: true;
                                background: #000000;

                                Image {
                                    source: root.last-capture-thumbnail;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: cover;
                                }
                            }

                            // Details & actions
                            VerticalBox {
                                alignment: space-between;
                                padding: 0px;
                                spacing: 2px;

                                Text {
                                    text: "Dernière capture";
                                    color: #38bdf8;
                                    font-size: 11px;
                                    font-weight: 700;
                                }
                                Text {
                                    text: root.last-capture-file-name;
                                    color: #cbd5e1;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                                HorizontalBox {
                                    padding: 0px;
                                    spacing: 6px;
                                    alignment: start;

                                    Button {
                                        text: "👁 Voir";
                                        clicked => { root.open-capture-file(root.last-capture-path); }
                                    }
                                    Button {
                                        text: "📁";
                                        clicked => { root.open-capture-directory(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom Session & Capture Bar
                Rectangle {
                    height: 84px;
                    border-radius: 8px;
                    background: #1c2127;

                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        alignment: space-between;

                        // Patient identity
                        HorizontalBox {
                            spacing: 8px;
                            alignment: start;

                            VerticalBox {
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Prénom"; color: #8b98a5; font-size: 11px; }
                                LineEdit {
                                    text <=> root.patient-first-name;
                                    placeholder-text: "Prénom";
                                    width: 120px;
                                }
                            }

                            VerticalBox {
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Nom"; color: #8b98a5; font-size: 11px; }
                                LineEdit {
                                    text <=> root.patient-last-name;
                                    placeholder-text: "Nom";
                                    width: 120px;
                                }
                            }

                            VerticalBox {
                                alignment: center;
                                spacing: 2px;
                                Text { text: "Œil"; color: #8b98a5; font-size: 11px; }
                                HorizontalBox {
                                    spacing: 4px;
                                    Button {
                                        text: "Gauche";
                                        primary: root.selected-eye == 1;
                                        clicked => { root.selected-eye = 1; }
                                    }
                                    Button {
                                        text: "Droit";
                                        primary: root.selected-eye == 2;
                                        clicked => { root.selected-eye = 2; }
                                    }
                                }
                            }

                            VerticalBox {
                                alignment: center;
                                Button {
                                    text: "Terminer session";
                                    clicked => { root.clear-session(); }
                                }
                            }
                        }

                        // Main Action Button (Photo / Video)
                        HorizontalBox {
                            spacing: 12px;
                            alignment: center;

                            HorizontalBox {
                                spacing: 4px;
                                alignment: center;
                                Button {
                                    text: "PHOTO";
                                    primary: !root.is-video-mode;
                                    clicked => { root.is-video-mode = false; }
                                }
                                Button {
                                    text: "VIDÉO";
                                    primary: root.is-video-mode;
                                    clicked => { root.is-video-mode = true; }
                                }
                            }

                            Button {
                                text: root.is-video-mode ? (root.is-recording ? "■ Arrêter Enreg." : "● Démarrer Vidéo") : "📷 Capturer Photo";
                                primary: true;
                                enabled: root.is-recording
                                    || (root.is-streaming
                                        && root.patient-first-name != ""
                                        && root.patient-last-name != ""
                                        && root.selected-eye != 0);
                                clicked => {
                                    if root.is-video-mode {
                                        root.toggle-recording();
                                    } else {
                                        root.trigger-capture();
                                    }
                                }
                            }

                            if !root.is-recording
                                && (root.patient-first-name == ""
                                    || root.patient-last-name == ""
                                    || root.selected-eye == 0): Text {
                                text: "Prénom, nom et œil requis";
                                color: #f59e0b;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        // Display Tools (Freeze, Zoom, Rotation)
                        HorizontalBox {
                            spacing: 6px;
                            alignment: end;

                            Button {
                                text: root.show-iridology-grid ? "Grille Iris (Active)" : "Grille Iris";
                                primary: root.show-iridology-grid;
                                clicked => { root.show-iridology-grid = !root.show-iridology-grid; }
                            }

                            Button {
                                text: root.is-frozen ? "Reprendre" : "Figer";
                                clicked => { root.toggle-freeze(); }
                            }

                            Button {
                                text: "100%";
                                primary: root.zoom-level == 100;
                                clicked => {
                                    root.zoom-level = 100;
                                    root.zoom-pan-x = 0px;
                                    root.zoom-pan-y = 0px;
                                }
                            }
                            Button {
                                text: "150%";
                                primary: root.zoom-level == 150;
                                clicked => {
                                    root.zoom-level = 150;
                                    root.zoom-pan-x = 0px;
                                    root.zoom-pan-y = 0px;
                                }
                            }
                            Button {
                                text: "200%";
                                primary: root.zoom-level == 200;
                                clicked => {
                                    root.zoom-level = 200;
                                    root.zoom-pan-x = 0px;
                                    root.zoom-pan-y = 0px;
                                }
                            }

                            Button {
                                text: "↻ " + root.rotation-angle + "°";
                                clicked => {
                                    root.rotation-angle = Math.mod(root.rotation-angle + 90, 360);
                                }
                            }

                            Button {
                                text: root.mirror-horizontal ? "Miroir H ✓" : "Miroir H";
                                primary: root.mirror-horizontal;
                                clicked => {
                                    root.mirror-horizontal = !root.mirror-horizontal;
                                }
                            }

                            Button {
                                text: root.mirror-vertical ? "Miroir V ✓" : "Miroir V";
                                primary: root.mirror-vertical;
                                clicked => {
                                    root.mirror-vertical = !root.mirror-vertical;
                                }
                            }
                        }
                    }
                }
            }

            // Tab 1: Image Controls
            if root.current-tab == 1: VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    alignment: space-between;

                    VerticalBox {
                        spacing: 4px;
                        Text {
                            text: "Réglages caméra en temps réel";
                            font-size: 20px;
                            font-weight: 700;
                            color: #ffffff;
                        }
                        Text {
                            text: "Les contrôles affichés proviennent directement de la caméra connectée.";
                            font-size: 12px;
                            color: #9ca3af;
                        }
                    }

                    Button {
                        text: "Valeurs d'origine";
                        enabled: root.camera-controls.length > 0;
                        clicked => { root.reset-camera-controls(); }
                    }
                }

                if root.camera-controls.length == 0: Rectangle {
                    height: 90px;
                    border-radius: 8px;
                    background: #1c2127;

                    Text {
                        text: root.camera-connected
                            ? "Aucun contrôle caméra n'est exposé par ce backend pour le moment."
                            : "Connectez le DE400 pour afficher ses réglages.";
                        color: #9ca3af;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                }

                ScrollView {
                    VerticalBox {
                        spacing: 10px;

                        for control in root.camera-controls: Rectangle {
                            height: control.kind == 0 ? 94px : 68px;
                            border-radius: 8px;
                            background: #1c2127;

                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;

                                HorizontalBox {
                                    alignment: space-between;

                                    Text {
                                        text: control.name;
                                        color: #e5e7eb;
                                        font-size: 14px;
                                        font-weight: 600;
                                    }

                                    if control.read-only: Text {
                                        text: "Lecture seule";
                                        color: #9ca3af;
                                        font-size: 11px;
                                    }
                                }

                                if control.kind == 0: HorizontalBox {
                                    spacing: 12px;

                                    Slider {
                                        minimum: control.minimum;
                                        maximum: control.maximum;
                                        value: control.value;
                                        enabled: !control.read-only;
                                        changed => {
                                            root.set-camera-control-value(control.key, self.value);
                                        }
                                    }

                                    Text {
                                        width: 72px;
                                        text: round(control.value * 100) / 100;
                                        color: #ffffff;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                }

                                if control.kind == 1: Button {
                                    text: control.boolean-value ? "Activé" : "Désactivé";
                                    enabled: !control.read-only;
                                    clicked => {
                                        root.set-camera-control-bool(
                                            control.key,
                                            !control.boolean-value
                                        );
                                    }
                                }

                                if control.kind == 2: Button {
                                    text: control.menu-label;
                                    enabled: !control.read-only;
                                    clicked => {
                                        root.cycle-camera-control-menu(control.key);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 2: Library
            if root.current-tab == 2: VerticalBox {
                padding: 24px;
                spacing: 16px;

                HorizontalBox {
                    alignment: space-between;
                    Text {
                        text: "Bibliothèque de Captures";
                        font-size: 20px;
                        font-weight: 700;
                        color: #ffffff;
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Button {
                            text: "🔄 Actualiser";
                            clicked => { root.refresh-library(); }
                        }
                        Button {
                            text: "📁 Ouvrir le dossier des captures";
                            clicked => { root.open-capture-directory(); }
                        }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;

                    Button {
                        text: "Session actuelle";
                        primary: root.library-filter == 3;
                        enabled: root.patient-first-name != "" && root.patient-last-name != "";
                        clicked => { root.library-filter = 3; }
                    }
                    Button {
                        text: "Tous";
                        primary: root.library-filter == 0;
                        clicked => { root.library-filter = 0; }
                    }
                    Button {
                        text: "Photos";
                        primary: root.library-filter == 1;
                        clicked => { root.library-filter = 1; }
                    }
                    Button {
                        text: "Vidéos";
                        primary: root.library-filter == 2;
                        clicked => { root.library-filter = 2; }
                    }
                }

                HorizontalBox {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        border-radius: 4px;
                        background: #065f46;
                        height: 24px;
                        HorizontalBox {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "Confidentialité Médicale Active";
                                color: #34d399;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: "Les clichés appartenant à d'autres patients sont strictement anonymisés dans cette vue.";
                        color: #9ca3af;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                if root.library-items.length == 0: Rectangle {
                    background: #181d23;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2f3842;
                    min-height: 350px;

                    VerticalBox {
                        alignment: center;
                        spacing: 8px;
                        Text {
                            text: "Aucun cliché dans la bibliothèque pour le moment.";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Prenez des photos ou enregistrez des vidéos depuis l'onglet Caméra.";
                            color: #9ca3af;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.library-items.length > 0: ScrollView {
                    min-height: 400px;
                    VerticalBox {
                        spacing: 8px;
                        for item in root.library-items: Rectangle {
                            visible: root.library-filter == 0
                                || (root.library-filter == 1 && !item.is-video)
                                || (root.library-filter == 2 && item.is-video)
                                || (root.library-filter == 3 && item.is-current-session);
                            height: self.visible ? 92px : 0px;
                            border-radius: 8px;
                            background: item.is-current-session ? #1c2738 : #181d23;
                            border-width: 1px;
                            border-color: item.is-current-session ? #3b82f6 : #2f3842;

                            HorizontalBox {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: space-between;

                                HorizontalBox {
                                    spacing: 12px;
                                    alignment: start;

                                    if item.has-thumbnail: Rectangle {
                                        width: 96px;
                                        height: 72px;
                                        border-radius: 6px;
                                        clip: true;
                                        background: #000000;

                                        Image {
                                            source: item.thumbnail;
                                            width: 100%;
                                            height: 100%;
                                            image-fit: cover;
                                        }
                                    }

                                    if !item.has-thumbnail: Rectangle {
                                        width: 96px;
                                        height: 72px;
                                        border-radius: 6px;
                                        background: #111827;

                                        Text {
                                            text: item.is-video ? "VIDÉO" : "IRIS";
                                            color: #9ca3af;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        width: 72px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: item.is-video ? #1e3a5f : #064e3b;

                                        HorizontalBox {
                                            alignment: center;
                                            Text {
                                                text: item.is-video ? "VIDÉO" : "PHOTO";
                                                color: item.is-video ? #60a5fa : #34d399;
                                                font-size: 11px;
                                                font-weight: 700;
                                            }
                                        }
                                    }

                                    VerticalBox {
                                        alignment: center;
                                        spacing: 2px;

                                        HorizontalBox {
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                text: item.title;
                                                color: #ffffff;
                                                font-size: 14px;
                                                font-weight: 600;
                                            }
                                            if item.is-current-session: Rectangle {
                                                border-radius: 4px;
                                                background: #1d4ed8;
                                                height: 18px;
                                                HorizontalBox {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    Text {
                                                        text: "Patient Actif";
                                                        color: #dbeafe;
                                                        font-size: 10px;
                                                        font-weight: 700;
                                                    }
                                                }
                                            }
                                            if !item.is-current-session: Rectangle {
                                                border-radius: 4px;
                                                background: #374151;
                                                height: 18px;
                                                HorizontalBox {
                                                    padding-left: 4px;
                                                    padding-right: 4px;
                                                    Text {
                                                        text: "Anonymisé";
                                                        color: #9ca3af;
                                                        font-size: 10px;
                                                    }
                                                }
                                            }
                                        }

                                        Text {
                                            text: item.date-time + "  •  " + item.eye-label;
                                            color: #9ca3af;
                                            font-size: 12px;
                                        }
                                    }
                                }

                                Button {
                                    text: "Ouvrir";
                                    clicked => { root.open-capture-file(item.file-path); }
                                }
                            }
                        }
                    }
                }
            }

            // Tab 3: Iridology reference images
            if root.current-tab == 3: VerticalBox {
                padding: 24px;
                spacing: 14px;

                HorizontalBox {
                    alignment: space-between;

                    VerticalBox {
                        spacing: 4px;

                        Text {
                            text: "Références d'iridologie";
                            font-size: 20px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        Text {
                            text: "Images de référence visuelle configurées par l'utilisateur.";
                            color: #9ca3af;
                            font-size: 12px;
                        }
                    }

                    HorizontalBox {
                        spacing: 6px;

                        Button {
                            text: "Carte de l'iris";
                            primary: root.iridology-reference-mode == 0;
                            clicked => {
                                root.iridology-reference-mode = 0;
                                root.iridology-reference-zoom = 100;
                                root.iridology-reference-pan-x = 0px;
                                root.iridology-reference-pan-y = 0px;
                            }
                        }

                        Button {
                            text: "Signes / symboles";
                            primary: root.iridology-reference-mode == 1;
                            clicked => {
                                root.iridology-reference-mode = 1;
                                root.iridology-reference-zoom = 100;
                                root.iridology-reference-pan-x = 0px;
                                root.iridology-reference-pan-y = 0px;
                            }
                        }

                        Button {
                            text: "100%";
                            primary: root.iridology-reference-zoom == 100;
                            clicked => {
                                root.iridology-reference-zoom = 100;
                                root.iridology-reference-pan-x = 0px;
                                root.iridology-reference-pan-y = 0px;
                            }
                        }

                        Button {
                            text: "150%";
                            primary: root.iridology-reference-zoom == 150;
                            clicked => {
                                root.iridology-reference-zoom = 150;
                                root.iridology-reference-pan-x = 0px;
                                root.iridology-reference-pan-y = 0px;
                            }
                        }

                        Button {
                            text: "200%";
                            primary: root.iridology-reference-zoom == 200;
                            clicked => {
                                root.iridology-reference-zoom = 200;
                                root.iridology-reference-pan-x = 0px;
                                root.iridology-reference-pan-y = 0px;
                            }
                        }
                    }
                }

                reference-frame := Rectangle {
                    clip: true;
                    border-radius: 8px;
                    background: #000000;
                    border-width: 1px;
                    border-color: #2f3842;

                    if root.iridology-reference-mode == 0 && root.has-iridology-map: Image {
                        source: root.iridology-map-image;
                        x: (parent.width - self.width) / 2 + root.iridology-reference-pan-x;
                        y: (parent.height - self.height) / 2 + root.iridology-reference-pan-y;
                        width: root.iridology-reference-zoom == 200
                            ? parent.width * 2
                            : root.iridology-reference-zoom == 150
                                ? parent.width * 1.5
                                : parent.width;
                        height: root.iridology-reference-zoom == 200
                            ? parent.height * 2
                            : root.iridology-reference-zoom == 150
                                ? parent.height * 1.5
                                : parent.height;
                        image-fit: contain;
                    }

                    if root.iridology-reference-mode == 1 && root.has-iridology-symbols: Image {
                        source: root.iridology-symbols-image;
                        x: (parent.width - self.width) / 2 + root.iridology-reference-pan-x;
                        y: (parent.height - self.height) / 2 + root.iridology-reference-pan-y;
                        width: root.iridology-reference-zoom == 200
                            ? parent.width * 2
                            : root.iridology-reference-zoom == 150
                                ? parent.width * 1.5
                                : parent.width;
                        height: root.iridology-reference-zoom == 200
                            ? parent.height * 2
                            : root.iridology-reference-zoom == 150
                                ? parent.height * 1.5
                                : parent.height;
                        image-fit: contain;
                    }

                    if root.iridology-reference-mode == 0 && !root.has-iridology-map: Text {
                        text: "Aucune carte configurée.\nAjoutez son chemin dans Paramètres.";
                        color: #9ca3af;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if root.iridology-reference-mode == 1 && !root.has-iridology-symbols: Text {
                        text: "Aucune planche de signes configurée.\nAjoutez son chemin dans Paramètres.";
                        color: #9ca3af;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    reference-pan := TouchArea {
                        enabled: root.iridology-reference-zoom > 100;
                        private property <length> pan-start-x;
                        private property <length> pan-start-y;

                        changed pressed => {
                            if self.pressed {
                                self.pan-start-x = root.iridology-reference-pan-x;
                                self.pan-start-y = root.iridology-reference-pan-y;
                            }
                        }

                        moved => {
                            if self.pressed {
                                root.iridology-reference-pan-x =
                                    self.pan-start-x + self.mouse-x - self.pressed-x;
                                root.iridology-reference-pan-y =
                                    self.pan-start-y + self.mouse-y - self.pressed-y;
                            }
                        }
                    }
                }
            }

            // Tab 4: Settings & Diagnostics
            if root.current-tab == 4: VerticalBox {
                padding: 24px;
                spacing: 20px;
                alignment: start;

                Text {
                    text: "Paramètres & Diagnostic Technique";
                    font-size: 20px;
                    font-weight: 700;
                    color: #ffffff;
                }

                HorizontalBox {
                    spacing: 24px;

                    // Diagnostic Technique
                    Rectangle {
                        border-radius: 8px;
                        background: #181d23;
                        border-width: 1px;
                        border-color: #2f3842;
                        width: 480px;

                        VerticalBox {
                            spacing: 10px;

                            Text {
                                text: "État Matériel & Flux Vidéo";
                                font-size: 15px;
                                font-weight: 700;
                                color: #60a5fa;
                            }

                            HorizontalBox { Text { text: "Périphérique :"; color: #9ca3af; } Text { text: root.diagnostics.device-name; color: #ffffff; } }
                            HorizontalBox { Text { text: "Identifiant :"; color: #9ca3af; } Text { text: root.diagnostics.device-id; color: #ffffff; } }
                            HorizontalBox { Text { text: "Backend Natif :"; color: #9ca3af; } Text { text: root.diagnostics.backend-name; color: #ffffff; } }
                            HorizontalBox { Text { text: "Identité USB :"; color: #9ca3af; } Text { text: root.diagnostics.usb-info; color: #ffffff; } }
                            HorizontalBox { Text { text: "Format actif :"; color: #9ca3af; } Text { text: root.diagnostics.active-format; color: #ffffff; } }
                            HorizontalBox { Text { text: "Résolution :"; color: #9ca3af; } Text { text: root.diagnostics.active-resolution; color: #ffffff; } }
                            HorizontalBox { Text { text: "FPS Caméra :"; color: #9ca3af; } Text { text: root.diagnostics.active-fps; color: #ffffff; } }
                            HorizontalBox { Text { text: "FPS Mesuré :"; color: #9ca3af; } Text { text: root.diagnostics.measured-fps; color: #34d399; font-weight: 700; } }
                            HorizontalBox { Text { text: "Temps décodage :"; color: #9ca3af; } Text { text: root.diagnostics.decode-time-ms; color: #ffffff; } }
                            HorizontalBox { Text { text: "Frames reçues :"; color: #9ca3af; } Text { text: "" + root.diagnostics.frame-count; color: #ffffff; } }
                            HorizontalBox { Text { text: "Frames ignorées :"; color: #9ca3af; } Text { text: "" + root.diagnostics.dropped-frames; color: #ffffff; } }
                        }
                    }

                    // Paramètres Généraux
                    Rectangle {
                        border-radius: 8px;
                        background: #181d23;
                        border-width: 1px;
                        border-color: #2f3842;
                        width: 480px;

                        VerticalBox {
                            spacing: 12px;

                            Text {
                                text: "Configuration & Stockage";
                                font-size: 15px;
                                font-weight: 700;
                                color: #60a5fa;
                            }

                            Text { text: "Dossier des captures :"; color: #9ca3af; }
                            LineEdit {
                                text: root.settings-capture-directory;
                                placeholder-text: "Chemin du dossier";
                                accepted(value) => {
                                    root.update-capture-directory(value);
                                }
                            }

                            Text { text: "Modèle de nommage :"; color: #9ca3af; }
                            LineEdit {
                                text: root.settings-filename-template;
                                placeholder-text: "{prenom}_{nom}_{oeil}_{date}_{heure}";
                                accepted(value) => {
                                    root.update-filename-template(value);
                                }
                            }
                            Text {
                                text: "Obligatoires : {prenom} {nom} {oeil}  •  Optionnels : {date} {heure}";
                                color: #6b7280;
                                font-size: 11px;
                            }

                            Text { text: "Bouton physique de l'iridoscope :"; color: #9ca3af; }
                            Button {
                                text: root.settings-button-mode == 1
                                    ? "Toujours Photo"
                                    : root.settings-button-mode == 2
                                        ? "Toujours Vidéo"
                                        : "Suit le mode actuel";
                                clicked => {
                                    root.cycle-physical-button-mode();
                                }
                            }

                            Text { text: "Carte d'iridologie (image) :"; color: #9ca3af; }
                            LineEdit {
                                text: root.settings-iridology-map-path;
                                placeholder-text: "Chemin vers une image JPEG/PNG";
                                accepted(value) => {
                                    root.update-iridology-map-path(value);
                                }
                            }

                            Text { text: "Planche signes / symboles :"; color: #9ca3af; }
                            LineEdit {
                                text: root.settings-iridology-symbols-path;
                                placeholder-text: "Chemin vers une image JPEG/PNG";
                                accepted(value) => {
                                    root.update-iridology-symbols-path(value);
                                }
                            }

                            Button {
                                text: "📁 Ouvrir le dossier des captures";
                                clicked => { root.open-capture-directory(); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.viewer-open: Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #05070af2;

        VerticalBox {
            padding: 24px;
            spacing: 12px;

            HorizontalBox {
                alignment: space-between;

                Text {
                    text: root.viewer-is-video ? "Vidéo de l'iris" : "Aperçu de l'iris";
                    color: #ffffff;
                    font-size: 18px;
                    font-weight: 700;
                }

                HorizontalBox {
                    spacing: 6px;

                    Button {
                        text: "100%";
                        primary: root.viewer-zoom == 100;
                        clicked => {
                            root.viewer-zoom = 100;
                            root.viewer-pan-x = 0px;
                            root.viewer-pan-y = 0px;
                        }
                    }
                    Button {
                        text: "150%";
                        primary: root.viewer-zoom == 150;
                        clicked => {
                            root.viewer-zoom = 150;
                            root.viewer-pan-x = 0px;
                            root.viewer-pan-y = 0px;
                        }
                    }
                    Button {
                        text: "200%";
                        primary: root.viewer-zoom == 200;
                        clicked => {
                            root.viewer-zoom = 200;
                            root.viewer-pan-x = 0px;
                            root.viewer-pan-y = 0px;
                        }
                    }
                    if root.viewer-is-video: Button {
                        text: root.viewer-video-playing ? "Pause" : "Lecture";
                        clicked => { root.toggle-viewer-video(); }
                    }

                    Button {
                        text: "Fermer";
                        clicked => {
                            root.viewer-open = false;
                            root.viewer-zoom = 100;
                            root.viewer-pan-x = 0px;
                            root.viewer-pan-y = 0px;
                            root.close-viewer();
                        }
                    }
                }
            }

            viewer-frame := Rectangle {
                clip: true;
                background: #000000;
                border-radius: 8px;

                Image {
                    source: root.viewer-image;
                    x: (parent.width - self.width) / 2 + root.viewer-pan-x;
                    y: (parent.height - self.height) / 2 + root.viewer-pan-y;
                    width: root.viewer-zoom == 200
                        ? parent.width * 2
                        : root.viewer-zoom == 150
                            ? parent.width * 1.5
                            : parent.width;
                    height: root.viewer-zoom == 200
                        ? parent.height * 2
                        : root.viewer-zoom == 150
                            ? parent.height * 1.5
                            : parent.height;
                    image-fit: contain;
                }

                viewer-pan := TouchArea {
                    enabled: root.viewer-zoom > 100;
                    private property <length> pan-start-x;
                    private property <length> pan-start-y;

                    changed pressed => {
                        if self.pressed {
                            self.pan-start-x = root.viewer-pan-x;
                            self.pan-start-y = root.viewer-pan-y;
                        }
                    }

                    moved => {
                        if self.pressed {
                            root.viewer-pan-x =
                                self.pan-start-x + self.mouse-x - self.pressed-x;
                            root.viewer-pan-y =
                                self.pan-start-y + self.mouse-y - self.pressed-y;
                        }
                    }
                }
            }
        }
    }

}
