import { AppButton } from "./controls.slint";
import { Design } from "./theme.slint";
import { HorizontalBox, Palette } from "std-widgets.slint";
import { AppState } from "./state.slint";
import { DiagnosticData, LibraryItemData, CameraControlUiData, PatientCandidateData } from "./models.slint";
import { CameraPage } from "./camera.slint";
import { LibraryPage } from "./library.slint";
import { SettingsPage } from "./settings.slint";
import { MapOverlay } from "./map-overlay.slint";
import { ViewerOverlay } from "./viewer-overlay.slint";
import { CaptureNotice } from "./capture-notice.slint";
import "./fonts/Manrope.ttf";
import "./fonts/InstrumentSerif-Regular.ttf";
export { DiagnosticData, LibraryItemData, CameraControlUiData, PatientCandidateData } from "./models.slint";
export { AppState } from "./state.slint";

export component MainWindow inherits Window {
    title: "IrisScope - Digital Microscope";
    full-screen: root.iris-fullscreen;
    min-width: 800px;
    min-height: 600px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Design.canvas;
    default-font-family: Design.font-ui;
    default-font-size: 13px;
    forward-focus: app-shortcuts;
    changed settings-theme => {
        Palette.color-scheme = root.settings-theme == 1 ? ColorScheme.light
            : root.settings-theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    changed viewer-open => {
        if (!root.viewer-open) { app-shortcuts.focus(); }
    }
    in-out property <image> live-frame <=> AppState.live-frame;
    in-out property <string> status-text <=> AppState.status-text;
    in-out property <bool> camera-connected <=> AppState.camera-connected;
    in-out property <bool> is-streaming <=> AppState.is-streaming;
    in-out property <string> patient-first-name <=> AppState.patient-first-name;
    in-out property <string> patient-last-name <=> AppState.patient-last-name;
    in-out property <string> patient-id <=> AppState.patient-id;
    in-out property <string> patient-dossier-number <=> AppState.patient-dossier-number;
    in-out property <[PatientCandidateData]> patient-candidates <=> AppState.patient-candidates;
    in-out property <bool> patient-search-pending <=> AppState.patient-search-pending;
    in-out property <bool> patient-action-pending <=> AppState.patient-action-pending;
    in-out property <int> selected-eye <=> AppState.selected-eye;
    in-out property <bool> is-video-mode <=> AppState.is-video-mode;
    in-out property <bool> is-recording <=> AppState.is-recording;
    in-out property <bool> recording-finalizing <=> AppState.recording-finalizing;
    in-out property <string> recording-duration <=> AppState.recording-duration;
    in-out property <bool> is-frozen <=> AppState.is-frozen;
    in-out property <int> zoom-level <=> AppState.zoom-level;
    in-out property <length> zoom-pan-x <=> AppState.zoom-pan-x;
    in-out property <length> zoom-pan-y <=> AppState.zoom-pan-y;
    in-out property <int> rotation-angle <=> AppState.rotation-angle;
    in-out property <bool> mirror-horizontal <=> AppState.mirror-horizontal;
    in-out property <bool> mirror-vertical <=> AppState.mirror-vertical;
    in-out property <int> current-tab <=> AppState.current-tab;
    in-out property <bool> sidebar-visible <=> AppState.sidebar-visible;
    in-out property <bool> iris-fullscreen <=> AppState.iris-fullscreen;
    in-out property <bool> image-controls-open <=> AppState.image-controls-open;
    in-out property <DiagnosticData> diagnostics <=> AppState.diagnostics;
    in-out property <string> last-capture-message <=> AppState.last-capture-message;
    in-out property <bool> show-last-capture <=> AppState.show-last-capture;
    in-out property <int> capture-notice-tone <=> AppState.capture-notice-tone;
    in-out property <int> capture-notice-revision <=> AppState.capture-notice-revision;
    in-out property <float> shutter-flash-opacity <=> AppState.shutter-flash-opacity;
    in-out property <image> last-capture-thumbnail <=> AppState.last-capture-thumbnail;
    in-out property <bool> has-last-capture <=> AppState.has-last-capture;
    in-out property <bool> has-last-capture-thumbnail <=> AppState.has-last-capture-thumbnail;
    in-out property <string> last-capture-file-name <=> AppState.last-capture-file-name;
    in-out property <string> last-capture-path <=> AppState.last-capture-path;
    in-out property <string> last-capture-file-version <=> AppState.last-capture-file-version;
    in-out property <int> session-photo-count <=> AppState.session-photo-count;
    in-out property <[CameraControlUiData]> camera-controls <=> AppState.camera-controls;
    in-out property <string> settings-capture-directory <=> AppState.settings-capture-directory;
    in-out property <string> settings-filename-template <=> AppState.settings-filename-template;
    in-out property <int> settings-button-mode <=> AppState.settings-button-mode;
    in-out property <int> settings-video-quality <=> AppState.settings-video-quality;
    in-out property <int> settings-theme <=> AppState.settings-theme;
    in-out property <string> settings-iridology-map-path <=> AppState.settings-iridology-map-path;
    in-out property <string> settings-iridology-symbols-path <=> AppState.settings-iridology-symbols-path;
    in-out property <string> settings-feedback <=> AppState.settings-feedback;
    in-out property <bool> settings-feedback-is-error <=> AppState.settings-feedback-is-error;
    in-out property <image> iridology-map-image <=> AppState.iridology-map-image;
    in-out property <image> iridology-symbols-image <=> AppState.iridology-symbols-image;
    in-out property <bool> has-iridology-map <=> AppState.has-iridology-map;
    in-out property <bool> has-iridology-symbols <=> AppState.has-iridology-symbols;
    in-out property <int> iridology-reference-mode <=> AppState.iridology-reference-mode;
    in-out property <int> iridology-reference-zoom <=> AppState.iridology-reference-zoom;
    in-out property <length> iridology-reference-pan-x <=> AppState.iridology-reference-pan-x;
    in-out property <length> iridology-reference-pan-y <=> AppState.iridology-reference-pan-y;
    in-out property <[LibraryItemData]> library-items <=> AppState.library-items;
    in-out property <int> library-filter <=> AppState.library-filter;
    in-out property <int> library-page <=> AppState.library-page;
    in-out property <int> library-total-count <=> AppState.library-total-count;
    in-out property <int> pending-recordings-count <=> AppState.pending-recordings-count;
    in-out property <string> library-page-summary <=> AppState.library-page-summary;
    in-out property <bool> library-loading <=> AppState.library-loading;
    in-out property <string> library-error <=> AppState.library-error;
    in-out property <int> library-view <=> AppState.library-view;
    in-out property <bool> library-map-open <=> AppState.library-map-open;
    in-out property <string> selected-library-path <=> AppState.selected-library-path;
    in-out property <string> selected-library-file-version <=> AppState.selected-library-file-version;
    in-out property <string> selected-library-dossier-number <=> AppState.selected-library-dossier-number;
    in-out property <bool> show-iridology-grid <=> AppState.show-iridology-grid;
    in-out property <bool> viewer-open <=> AppState.viewer-open;
    in-out property <bool> viewer-loading <=> AppState.viewer-loading;
    in-out property <image> viewer-image <=> AppState.viewer-image;
    in-out property <int> viewer-zoom <=> AppState.viewer-zoom;
    in-out property <length> viewer-pan-x <=> AppState.viewer-pan-x;
    in-out property <length> viewer-pan-y <=> AppState.viewer-pan-y;
    in-out property <bool> viewer-is-video <=> AppState.viewer-is-video;
    in-out property <bool> viewer-video-playing <=> AppState.viewer-video-playing;
    in-out property <float> viewer-video-progress <=> AppState.viewer-video-progress;
    in-out property <string> viewer-video-position <=> AppState.viewer-video-position;
    in-out property <string> viewer-video-duration <=> AppState.viewer-video-duration;

    private property <int> viewport-controls-revision <=> AppState.viewport-controls-revision;
    changed viewport-controls-revision => { viewport-controls-timer.restart(); }

    viewport-controls-timer := Timer {
        interval: 1s;
        running: AppState.viewport-controls-visible;
        triggered => { AppState.viewport-controls-visible = false; }
    }

    app-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;

        // One shortcut scope covers the active page and the private viewer.
        KeyBinding { keys: @keys(Control + "1"); enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open; activated => { AppState.navigate-to(0); AppState.image-controls-open = false; } }
        KeyBinding { keys: @keys(Control + "2"); enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open; activated => { AppState.navigate-to(0); AppState.image-controls-open = !AppState.image-controls-open; } }
        KeyBinding { keys: @keys(Control + "3"); enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open; activated => { AppState.navigate-to(2); } }
        KeyBinding { keys: @keys(Control + "4"); enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open; activated => { AppState.navigate-to(2); AppState.iridology-reference-mode = 0; AppState.library-map-open = true; } }
        KeyBinding { keys: @keys(Control + "5"); enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open; activated => { AppState.navigate-to(4); } }

        KeyBinding {
            keys: @keys(Control + P);
            enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open && AppState.current-tab == 0
                && AppState.is-streaming && !AppState.recording-busy && AppState.selected-eye != 0
                && (AppState.patient-id != "" || (AppState.patient-first-name == "" && AppState.patient-last-name == ""));
            activated => { AppState.trigger-capture(); }
        }
        KeyBinding {
            keys: @keys(Control + R);
            enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open && AppState.current-tab == 0
                && !AppState.recording-finalizing && (AppState.is-recording || (AppState.is-streaming && AppState.selected-eye != 0
                    && (AppState.patient-id != "" || (AppState.patient-first-name == "" && AppState.patient-last-name == ""))));
            activated => { AppState.toggle-recording(); }
        }
        KeyBinding {
            keys: @keys(Control + F);
            enabled: !AppState.text-field-focused && !AppState.viewer-open && !AppState.library-map-open && AppState.current-tab == 0
                && (AppState.is-streaming || AppState.is-frozen);
            activated => { AppState.toggle-freeze(); }
        }
        KeyBinding {
            keys: @keys(Escape);
            enabled: AppState.viewer-open || AppState.image-controls-open || AppState.library-map-open || AppState.iris-fullscreen;
            activated => {
                if AppState.viewer-open { AppState.dismiss-viewer(); }
                else if AppState.library-map-open { AppState.library-map-open = false; }
                else if AppState.image-controls-open { AppState.image-controls-open = false; }
                else { AppState.iris-fullscreen = false; }
            }
        }

        Rectangle {
            width: 100%;
            height: 100%;

            // The capture surface remains quiet; navigation and camera status live here.
            Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 64px;
                visible: !AppState.iris-fullscreen && !AppState.viewer-open && !AppState.library-map-open;
                background: Design.header;

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Design.border;
                }

                HorizontalBox {
                    y: 0px;
                    width: 100%;
                    height: 40px;
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    HorizontalBox {
                        spacing: Design.gap;
                        alignment: start;
                        height: 40px;

                        Rectangle {
                            visible: root.width >= 900px;
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            border-width: 2px;
                            border-color: Design.accent;
                            background: Design.header;
                            Rectangle {
                                x: 7px;
                                y: 7px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Design.accent;
                            }
                        }

                        Text {
                            visible: root.width >= 900px;
                            text: "IRISCOPE";
                            color: Design.accent;
                            font-size: 16px;
                            font-weight: 700;
                            letter-spacing: 1.8px;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            visible: root.width >= 900px;
                            width: 1px;
                            height: 24px;
                            background: Design.border;
                        }

                        AppButton {
                            height: 40px;
                            text: "Caméra";
                            quiet: true;
                            primary: AppState.current-tab == 0 && !AppState.image-controls-open;
                            selected: AppState.current-tab == 0 && !AppState.image-controls-open;
                            clicked => { AppState.navigate-to(0); AppState.image-controls-open = false; }
                        }

                        AppButton {
                            height: 40px;
                            text: root.width < 1120px ? "Image" : "Réglages image";
                            quiet: true;
                            primary: AppState.current-tab == 0 && AppState.image-controls-open;
                            selected: AppState.current-tab == 0 && AppState.image-controls-open;
                            clicked => {
                                AppState.navigate-to(0);
                                AppState.image-controls-open = !AppState.image-controls-open;
                            }
                        }

                        AppButton {
                            height: 40px;
                            text: "Bibliothèque";
                            quiet: true;
                            primary: AppState.current-tab == 2;
                            selected: AppState.current-tab == 2;
                            clicked => { AppState.navigate-to(2); }
                        }

                        AppButton {
                            height: 40px;
                            text: root.width < 1120px ? "Paramètres" : "Paramètres et diagnostic";
                            quiet: true;
                            primary: AppState.current-tab == 4;
                            selected: AppState.current-tab == 4;
                            clicked => { AppState.navigate-to(4); }
                        }

                    }

                    HorizontalBox {
                        spacing: 10px;
                        alignment: end;

                        Rectangle {
                            width: root.width < 1120px ? 160px : 220px;
                            border-radius: 15px;
                            border-width: 1px;
                            border-color: AppState.camera-connected ? #3e614b : #79504a;
                            background: AppState.camera-connected ? Design.success-surface : Design.error-surface;
                            height: 30px;

                            Rectangle {
                                x: 8px;
                                y: 11px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: AppState.camera-connected ? Design.success : Design.danger;
                            }

                            Text {
                                x: 22px;
                                y: 0px;
                                width: parent.width - 30px;
                                height: 100%;
                                text: AppState.status-text;
                                overflow: elide;
                                color: AppState.camera-connected ? Design.success : Design.danger;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Rectangle {
                x: 0px; y: AppState.iris-fullscreen ? 0px : 64px; width: 100%; height: parent.height - self.y; background: Design.canvas;
                visible: !AppState.viewer-open && !AppState.library-map-open;
                if AppState.current-tab == 0: CameraPage { width: 100%; height: 100%; }
                if AppState.current-tab == 2: LibraryPage { width: 100%; height: 100%; }
                if AppState.current-tab == 4: SettingsPage { width: 100%; height: 100%; }
            }
        }
        if AppState.library-map-open: MapOverlay { width: 100%; height: 100%; }
        if AppState.viewer-open: ViewerOverlay { width: 100%; height: 100%; }
        if AppState.show-last-capture: CaptureNotice { width: 100%; height: 100%; }
    }
}
